<Project Sdk="Microsoft.NET.Sdk">

  <!-- Automatic checks of the core logic. GitHub runs them after every build;
       in Visual Studio: Test > Run All Tests. -->
  <PropertyGroup>
    <!-- Windows, because some tests check the paint tools of the (WPF) viewer -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- Files the tests read (a Photoshop file written by another program, ImageMagick) -->
  <ItemGroup>
    <None Update="Files\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- and your own files, if you put some in PrivateFiles (git leaves them out) -->
    <None Update="PrivateFiles\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Animator.Core\Animator.Core.csproj" />
    <ProjectReference Include="..\Animator.Viewer\Animator.Viewer.csproj" />
  </ItemGroup>

</Project>
