<Window x:Class="Animator.Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="Animator" Height="860" Width="1450"
        Closing="Window_Closing"
        PreviewKeyDown="Window_KeyDown">
        <DockPanel>
            <!-- A menu item's Tag is its command in the key map: its key is filled in from there -->
            <Menu x:Name="MainMenu" DockPanel.Dock="Top">
                <MenuItem Header="_File">
                    <MenuItem Header="_New…" Tag="file.new" InputGestureText="Ctrl+N" Click="New_Click" />
                    <MenuItem Header="_Open…" Tag="file.open" InputGestureText="Ctrl+O" Click="Open_Click" />
                    <Separator />
                    <MenuItem Header="_Save" Tag="file.save" InputGestureText="Ctrl+S" Click="Save_Click" />
                    <MenuItem Header="Save _As…" Tag="file.saveAs" InputGestureText="Ctrl+Shift+S" Click="SaveAs_Click" />
                    <Separator />
                    <MenuItem Header="_Import…" Tag="file.import" InputGestureText="Ctrl+I" Click="Import_Click"
                              ToolTip="A Photoshop file (its layers as parts, with a suggested rig if you like), an Animate project (.fla or .xfl: its parts and animations, with a rig worked out from them if you like), or a sprite sheet (its pieces as stills and animations)" />
                    <MenuItem Header="_Export…" Tag="file.export" InputGestureText="Ctrl+E" Click="Export_Click"
                              ToolTip="PNG pictures, a GIF, a sprite sheet or a video: of the scene, or of one object's animations" />
                    <Separator />
                    <MenuItem Header="E_xit" Click="Exit_Click" />
                </MenuItem>
                <MenuItem x:Name="EditMenu" Header="_Edit" SubmenuOpened="EditMenu_Opened">
                    <MenuItem Header="_Undo" Tag="edit.undo" Click="MenuCommand_Click" />
                    <MenuItem Header="_Redo" Tag="edit.redo" Click="MenuCommand_Click" />
                    <Separator />
                    <MenuItem Header="_Pick every bone and part shown" Tag="pick.all" Click="MenuCommand_Click"
                              ToolTip="Hidden and locked ones stay as they are" />
                    <MenuItem Header="Select the _keys of the picked" Tag="pick.keys" Click="MenuCommand_Click"
                              ToolTip="Every key of the picked bones and parts, in the timeline. Then dragging them in the viewport moves those keys alike: the animation plays as it did, moved." />
                    <Separator />
                    <MenuItem Header="_Hide the picked" Tag="pick.hide" Click="MenuCommand_Click"
                              ToolTip="Out of the way while you work (a hidden bone hides what's on it and under it). Exports still show everything." />
                    <MenuItem Header="Hide everything _else" Tag="pick.hideOthers" Click="MenuCommand_Click" />
                    <MenuItem Header="_Show everything" Tag="pick.showAll" Click="MenuCommand_Click" />
                    <Separator />
                    <MenuItem Header="_Lock the picked" Tag="pick.lock" Click="MenuCommand_Click"
                              ToolTip="Locked bones and parts can't be clicked, boxed or dragged in the viewport, so they stay put while you work around them. The rig panel can still pick them (to type in numbers)." />
                    <MenuItem Header="Lock e_verything else" Tag="pick.lockOthers" Click="MenuCommand_Click" />
                    <MenuItem Header="U_nlock everything" Tag="pick.unlockAll" Click="MenuCommand_Click" />
                    <Separator />
                    <MenuItem Header="Se_ttings…" Tag="file.settings" InputGestureText="Ctrl+," Click="MenuCommand_Click"
                              ToolTip="Which key does what (every shortcut and paint tool), which mouse button picks, moves things and moves the view, and how often unsaved work is kept" />
                </MenuItem>
                <MenuItem x:Name="ViewMenu" Header="_View" SubmenuOpened="ViewMenu_Opened">
                    <MenuItem Header="_Rulers" Tag="view.rulers" Click="MenuCommand_Click"
                              ToolTip="Along the top and left: drag a guide out of one" />
                    <MenuItem Header="_Grid" Tag="view.grid" Click="MenuCommand_Click" />
                    <MenuItem Header="G_uides" Tag="view.guides" Click="MenuCommand_Click"
                              ToolTip="Drag one out of a ruler; drag it back onto the ruler to take it away" />
                    <Separator />
                    <MenuItem Header="_Snap to the grid" Tag="view.snapGrid" Click="MenuCommand_Click"
                              ToolTip="Joints, bone ends, parts (their pivot or a corner of their box) and objects dragged near a grid line land on it" />
                    <MenuItem Header="Snap to the gu_ides" Tag="view.snapGuides" Click="MenuCommand_Click" />
                    <MenuItem Header="_Lock the guides" Tag="view.lockGuides" Click="MenuCommand_Click"
                              ToolTip="Guides can't be moved by accident (new ones can still be dragged out of the rulers)" />
                    <Separator />
                    <MenuItem x:Name="GridSizeMenu" Header="Grid si_ze" />
                    <MenuItem x:Name="ClearGuidesItem" Header="_Clear the guides" Click="ClearGuides_Click" />
                    <Separator />
                    <MenuItem Header="_Pictures" Tag="view.images" Click="MenuCommand_Click" />
                    <MenuItem Header="Pi_xel filtering" Tag="view.pixels" Click="MenuCommand_Click" />
                    <MenuItem Header="_Onion skin" Tag="view.onion" Click="MenuCommand_Click" />
                    <MenuItem Header="R_eset the view" Tag="view.reset" Click="MenuCommand_Click" />
                </MenuItem>
            </Menu>
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="214" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="PaintColumn" Width="0" />
        </Grid.ColumnDefinitions>

            <DockPanel Grid.Row="0" Grid.Column="0">

                <!-- ===== Objects and rig panel ===== -->
                <DockPanel DockPanel.Dock="Left" Width="250" Background="#24272E">

                    <!-- Objects in the scene (top of the list = in front) -->
                    <DockPanel DockPanel.Dock="Top" Margin="8,6,6,4">
                        <Button x:Name="SceneButton" DockPanel.Dock="Right" Padding="6,1" Click="SceneButton_Click"
                    ToolTip="Back to the scene, to place whole objects (Esc). At scene level: open the selected object (Enter)" />
                        <TextBlock Text="Objects" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ListBox x:Name="ObjectList" DockPanel.Dock="Top" MinHeight="40" MaxHeight="110" Margin="6,0,6,4"
             Background="#1E2026" Foreground="White" BorderThickness="0"
             SelectionChanged="ObjectList_Changed" MouseDoubleClick="ObjectList_DoubleClick"
             ToolTip="Top = in front. Double-click an object to edit it." />
                    <UniformGrid DockPanel.Dock="Top" Columns="5" Margin="6,0,6,4">
                        <Button Content="+ New ▾" Margin="0,0,2,0" Click="AddObject_Click"
                    ToolTip="Adds an object to the scene, in the middle of the view" />
                        <Button x:Name="CopyObjectButton" Content="Copy" Margin="2,0,2,0" Click="CopyObject_Click"
                    ToolTip="A copy of the object, with its own rig, animations and drawings" />
                        <Button x:Name="DeleteObjectButton" Content="Delete" Margin="2,0,2,0" Click="DeleteObject_Click"
                    ToolTip="Deletes the object (undoable). A scene always keeps at least one." />
                        <Button x:Name="ObjectUpButton" Content="▲" Margin="2,0,2,0" Click="ObjectUp_Click"
                    ToolTip="Forward: in front of more objects" />
                        <Button x:Name="ObjectDownButton" Content="▼" Margin="2,0,0,0" Click="ObjectDown_Click"
                    ToolTip="Backward: behind more objects" />
                    </UniformGrid>
                    <TextBlock x:Name="ModeText" DockPanel.Dock="Top" Foreground="#9AA4B2" TextWrapping="Wrap" Margin="8,0,8,6" />
                    <Border DockPanel.Dock="Top" Height="1" Background="#3A3F4A" Margin="6,0,6,4" />

                    <Grid>
                        <!-- Scene level: the selected object's place and settings -->
                        <ScrollViewer x:Name="ObjectProps" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel>
                            <Grid x:Name="ObjectFields" Margin="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="ObjectTitle" Grid.Row="0" Grid.ColumnSpan="3" Foreground="#9AA4B2"
                   TextWrapping="Wrap" Margin="0,0,0,6" />

                                <TextBlock Grid.Row="1" Text="Name" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                                <TextBox x:Name="ObjectName" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,4"
                 Tag="OName" KeyDown="ObjectField_KeyDown" LostFocus="ObjectField_LostFocus" />

                                <TextBlock Grid.Row="2" Text="X / Y" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                                <TextBox x:Name="ObjectX" Grid.Row="2" Grid.Column="1" Margin="0,0,2,4"
                 Tag="OX" KeyDown="ObjectField_KeyDown" LostFocus="ObjectField_LostFocus"
                 ToolTip="Where the object's origin (the green cross) is in the scene" />
                                <TextBox x:Name="ObjectY" Grid.Row="2" Grid.Column="2" Margin="2,0,0,4"
                 Tag="OY" KeyDown="ObjectField_KeyDown" LostFocus="ObjectField_LostFocus" />

                                <TextBlock Grid.Row="3" Text="Rotation°" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                                <TextBox x:Name="ObjectRotation" Grid.Row="3" Grid.Column="1" Margin="0,0,2,4"
                 Tag="ORotation" KeyDown="ObjectField_KeyDown" LostFocus="ObjectField_LostFocus" />

                                <TextBlock Grid.Row="4" Text="Scale" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                                <TextBox x:Name="ObjectScaleX" Grid.Row="4" Grid.Column="1" Margin="0,0,2,4"
                 Tag="OScaleX" KeyDown="ObjectField_KeyDown" LostFocus="ObjectField_LostFocus"
                 ToolTip="1 = its own size. A negative number mirrors it." />
                                <TextBox x:Name="ObjectScaleY" Grid.Row="4" Grid.Column="2" Margin="2,0,0,4"
                 Tag="OScaleY" KeyDown="ObjectField_KeyDown" LostFocus="ObjectField_LostFocus" />

                                <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,4,0,4">
                                    <CheckBox x:Name="ObjectVisible" Content="Visible" Foreground="White" Margin="0,0,12,0"
                      Click="ObjectFlags_Click" ToolTip="Hidden objects aren't drawn in the scene (they still show while you edit them)" />
                                    <CheckBox x:Name="ObjectLocked" Content="Locked" Foreground="White"
                      Click="ObjectFlags_Click" ToolTip="Locked objects can't be clicked or dragged in the viewport (handy for backgrounds)" />
                                </StackPanel>
                                <StackPanel Grid.Row="6" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,6">
                                    <CheckBox x:Name="ObjectExport" Content="Export" Foreground="White" Margin="0,0,12,0"
                      Click="ObjectFlags_Click" ToolTip="Included when exporting (milestone 10)" />
                                    <CheckBox x:Name="ObjectOnion" Content="Onion skin" Foreground="White"
                      Click="ObjectFlags_Click" ToolTip="Shows onion-skin ghosts at scene level (O turns onion skin on and off)" />
                                </StackPanel>

                                <TextBlock Grid.Row="7" Text="Preview" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                                <ComboBox x:Name="ObjectPreview" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,4"
                  SelectionChanged="ObjectPreview_Changed"
                  ToolTip="The animation this object plays at scene level, and while you edit other objects" />

                                <TextBlock Grid.Row="8" Text="Attached to" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                                <ComboBox x:Name="ObjectAttach" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,4"
                  SelectionChanged="ObjectAttach_Changed"
                  ToolTip="Carried by another object's bone (a sword in a hand, a hat on a head): it moves, turns and scales with that bone. It stays where it is when you attach or free it." />

                                <UniformGrid Grid.Row="9" Grid.ColumnSpan="3" Columns="2" Margin="0,6,0,4">
                                    <Button Content="Edit this object ▸" Margin="0,0,3,0" Click="EditSelected_Click"
                    ToolTip="Opens the object to edit its rig, drawings and animations (double-click or Enter)" />
                                    <Button Content="+ Clip at playhead ▾" Margin="3,0,0,0" Click="AddClipAtPlayhead_Click"
                    ToolTip="Puts one of its animations on the scene timeline, starting at the playhead (or right-click its row in the scene timeline)" />
                                </UniformGrid>

                                <TextBlock x:Name="ObjectHint" Grid.Row="10" Grid.ColumnSpan="3" Foreground="#FF8080" TextWrapping="Wrap" />
                            </Grid>

                            <!-- The clip picked in the scene timeline -->
                            <Grid x:Name="ClipFields" Margin="6,0,6,6" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="ClipTitle" Grid.Row="0" Grid.ColumnSpan="3" Foreground="#9AA4B2"
                   TextWrapping="Wrap" Margin="0,8,0,6" />

                                <TextBlock Grid.Row="1" Text="Animation" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                                <ComboBox x:Name="ClipAnimation" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,4"
                  DisplayMemberPath="Name" SelectionChanged="ClipAnimation_Changed"
                  ToolTip="Which of the object's animations this clip plays" />

                                <TextBlock Grid.Row="2" Text="Start / Length" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                                <TextBox x:Name="ClipStart" Grid.Row="2" Grid.Column="1" Margin="0,0,2,4"
                 Tag="CStart" KeyDown="ClipField_KeyDown" LostFocus="ClipField_LostFocus"
                 ToolTip="The scene frame the clip starts on" />
                                <TextBox x:Name="ClipLength" Grid.Row="2" Grid.Column="2" Margin="2,0,0,4"
                 Tag="CLength" KeyDown="ClipField_KeyDown" LostFocus="ClipField_LostFocus"
                 ToolTip="How many scene frames it lasts. Longer than the animation: it loops, or holds its last frame." />

                                <TextBlock Grid.Row="3" Text="From frame" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                                <TextBox x:Name="ClipOffset" Grid.Row="3" Grid.Column="1" Margin="0,0,2,4"
                 Tag="COffset" KeyDown="ClipField_KeyDown" LostFocus="ClipField_LostFocus"
                 ToolTip="The animation's frame the clip starts on (the frames before it are trimmed off)" />
                                <CheckBox x:Name="ClipLoop" Grid.Row="3" Grid.Column="2" Content="Loop" Foreground="White"
                  VerticalAlignment="Center" Margin="6,0,0,4" Click="ClipLoop_Click"
                  ToolTip="On: a clip longer than its animation plays it again. Off: it holds the last frame." />

                                <UniformGrid Grid.Row="4" Grid.ColumnSpan="3" Columns="2" Margin="0,4,0,4">
                                    <Button Content="Edit in place ▸" Margin="0,0,3,0" Click="ClipEdit_Click"
                    ToolTip="Opens the object at this clip's animation and frame; the rest of the scene plays along (or double-click the clip)" />
                                    <Button Content="Delete clip" Margin="3,0,0,0" Click="ClipDelete_Click" ToolTip="Del" />
                                </UniformGrid>

                                <TextBlock x:Name="ClipHint" Grid.Row="5" Grid.ColumnSpan="3" Foreground="#FF8080" TextWrapping="Wrap" />
                            </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Inside an object: its rig. The splitter between the tree and the properties can be dragged. -->
                        <Grid x:Name="RigSection">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2*" MinHeight="50" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="3*" MinHeight="80" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="8,2,6,4">
                                <CheckBox x:Name="SnapJointsBox" DockPanel.Dock="Right" Content="Snap to ends" Foreground="White"
                          IsChecked="True" VerticalAlignment="Center" Click="SnapJoints_Click"
                          ToolTip="Setup mode: a new bone started near the selected bone's end (Ctrl+drag), or a joint dragged near its parent's end, snaps exactly onto it and stays there (&quot;On parent's end&quot; in the bone panel). Pull it further away to free it." />
                                <TextBlock x:Name="RigTitle" Text="Rig" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" />
                            </DockPanel>

                            <!-- Rigging: for a rigged object, how bones move over the art; a drawn object can get bones -->
                            <Grid Grid.Row="1" Margin="8,0,6,6">
                                <CheckBox x:Name="KeepPartsBox" Content="Parts stay put when bones move" Foreground="White"
                          VerticalAlignment="Center" Click="KeepParts_Click"
                          ToolTip="Setup mode: dragging a joint or turning a bone leaves every part, and every other joint, where it is: for fitting bones to finished art. Off: the parts on a bone move with it." />
                                <Button x:Name="GiveBonesButton" Content="Give it bones ▾" Click="GiveBones_Click" Visibility="Collapsed"
                        ToolTip="Makes this drawn object a rigged one: a root bone you draw the rest from (Ctrl+drag), or bones suggested from its parts' shapes. The parts stay where they are." />
                            </Grid>
                            <UniformGrid Grid.Row="2" Columns="4" Margin="6,0,6,6">
                                <Button x:Name="AddBoneButton" Content="+ Bone" Margin="0,0,2,0" Click="AddBone_Click"
                            ToolTip="Adds a child of the selected bone (or a root bone). Tip: Ctrl+drag in the viewport draws one." />
                                <Button Content="+ Part ▾" Margin="2,0,2,0" Click="AddPart_Click"
                            ToolTip="Adds a part (blank, or from an image) to the selected bone" />
                                <Button x:Name="BindButton" Content="Bind ▾" Margin="2,0,2,0" Click="Bind_Click"
                            ToolTip="Puts parts on bones (they stay where they are): on the nearest bones, or see the ways to do it by hand" />
                                <Button x:Name="DeleteButton" Content="Delete ▾" Margin="2,0,0,0" Click="Delete_Click"
                            ToolTip="Deletes the selected part, or the selected bone: keeping what's on it (it goes to the bone above), or with everything on it. Undoable." />
                            </UniformGrid>

                            <!-- Two views of the same object: its bones (parts under the bone they're on), or its
                                 parts as layers, in the order they're drawn whatever bone they're on -->
                            <StackPanel Grid.Row="3" Margin="6,0,6,4">
                                <UniformGrid x:Name="RigViewSwitch" Columns="3">
                                    <RadioButton x:Name="BonesViewChoice" Content="Bones" GroupName="RigView" Margin="0,0,1,0"
                                                 Style="{StaticResource {x:Type ToggleButton}}" Checked="RigView_Changed"
                                                 ToolTip="The bones, each part under the bone it's on: drag a part onto a bone to put it there, or a bone onto another to hang it there" />
                                    <RadioButton x:Name="LayersViewChoice" Content="Layers" GroupName="RigView" Margin="1,0,0,0"
                                                 Style="{StaticResource {x:Type ToggleButton}}" Checked="RigView_Changed"
                                                 ToolTip="Every part in the order it's drawn, the top one in front, whatever bone it's on. Drag one up or down to change the order; right-click for more (Ctrl+] / Ctrl+[ a step, with Shift all the way). In Animate mode, that keys the order at the playhead." />
                                    <RadioButton x:Name="ColourViewChoice" Content="Colour" GroupName="RigView" Margin="1,0,0,0"
                                                 Style="{StaticResource {x:Type ToggleButton}}" Checked="RigView_Changed"
                                                 ToolTip="Colour layers on the whole object: hue and saturation, brightness and contrast, tint, colour balance. Each can leave parts out, and its numbers can be keyed." />
                                </UniformGrid>
                                <TextBlock x:Name="LayersHint" Foreground="#9AA4B2" FontSize="11" TextWrapping="Wrap" Margin="2,4,2,0" Visibility="Collapsed" />
                                <!-- Selection sets: a click picks a set's bones and parts again -->
                                <DockPanel x:Name="SetsRow" Margin="0,5,0,0">
                                    <TextBlock DockPanel.Dock="Left" Text="Sets" Foreground="#9AA4B2" FontSize="11" Margin="2,1,6,0" VerticalAlignment="Top" />
                                    <WrapPanel x:Name="SetChips" />
                                </DockPanel>
                            </StackPanel>

                            <!-- Bones: drag a part onto a bone to put it there, or a bone onto another to hang it there.
                                 Layers: drag a part up or down to change the order. -->
                            <TreeView x:Name="BoneTree" Grid.Row="4" Background="#1E2026" BorderThickness="0" Margin="6,0,6,0"
                      SelectedItemChanged="BoneTree_SelectedItemChanged" AllowDrop="True"
                      PreviewMouseLeftButtonDown="BoneTree_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="BoneTree_PreviewMouseLeftButtonUp"
                      PreviewMouseMove="BoneTree_PreviewMouseMove"
                      DragOver="BoneTree_DragOver" DragLeave="BoneTree_DragLeave" Drop="BoneTree_Drop" />
                            <!-- Colour: the object's colour layers, and the settings of the one selected -->
                            <DockPanel x:Name="ColourPanel" Grid.Row="4" Margin="6,0,6,0" Visibility="Collapsed" Background="#1E2026">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,4,2,4">
                                    <Button Content="+ Colour layer ▾" Padding="6,1" Margin="0,0,4,0" Click="ColourAdd_Click"
                                            ToolTip="A new colour layer on the whole object (on top of the others)" />
                                    <Button x:Name="ColourDeleteButton" Content="Delete" Padding="6,1" Margin="0,0,4,0" Click="ColourDelete_Click" />
                                    <Button x:Name="ColourUpButton" Content="▲" Padding="5,1" Margin="0,0,2,0" Click="ColourUp_Click" ToolTip="Earlier (applied before the others)" />
                                    <Button x:Name="ColourDownButton" Content="▼" Padding="5,1" Click="ColourDown_Click" ToolTip="Later (applied after the others)" />
                                </StackPanel>
                                <ListBox x:Name="ColourList" DockPanel.Dock="Top" MaxHeight="110" Background="#24272E" Foreground="White"
                                         BorderThickness="0" SelectionChanged="ColourList_SelectionChanged" />
                                <TextBlock x:Name="ColourHint" DockPanel.Dock="Top" Foreground="#9AA4B2" FontSize="11" TextWrapping="Wrap" Margin="2,4,2,2" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="2,0,4,6">
                                        <DockPanel x:Name="ColourNameRow" Margin="0,2,0,4">
                                            <TextBlock Text="Name" Foreground="White" Width="74" VerticalAlignment="Center" />
                                            <TextBox x:Name="ColourName" KeyDown="ColourName_KeyDown" LostFocus="ColourName_LostFocus" />
                                        </DockPanel>
                                        <StackPanel x:Name="ColourSettings" />
                                        <Expander x:Name="ColourLeaveOut" Header="Leave out" Foreground="White" Margin="0,6,0,0"
                                                  ToolTip="Parts this colour layer doesn't change (the eyes of a body made green, say)">
                                            <StackPanel x:Name="ColourLeaveOutList" Margin="6,2,0,0" />
                                        </Expander>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                            <GridSplitter Grid.Row="5" Height="5" HorizontalAlignment="Stretch" Background="#1B1D22"
                          ResizeDirection="Rows" ToolTip="Drag to give the tree or the properties more room" />

                            <!-- Properties of the selected bone or part (one shows at a time) -->
                            <ScrollViewer Grid.Row="6" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock x:Name="DrawnHint" Margin="8,6,8,6" Foreground="#9AA4B2" TextWrapping="Wrap" Visibility="Collapsed"
                       Text="A drawn object has no bones, just parts (layers): click one in the list above or in the viewport. + Part ▾ adds one; drag one up or down in the list (or ▲ Front / ▼ Back) to change their order. Double-click a part to paint it. To animate it with bones, Give it bones ▾ above." />
                                    <Grid x:Name="BoneProps" Margin="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,6">
                                            <Button x:Name="BoneColorButton" DockPanel.Dock="Right" Width="24" Height="18" Padding="0" Click="BoneColor_Click"
                                                    ToolTip="The bone's colour in the viewport (all the picked bones at once)">
                                                <Border x:Name="BoneColorSwatch" Width="14" Height="10" BorderBrush="#202020" BorderThickness="1" />
                                            </Button>
                                            <TextBlock x:Name="PropsTitle" Foreground="#9AA4B2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>

                                        <TextBlock Grid.Row="1" Text="Name" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                                        <TextBox x:Name="BoneName" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,4"
                             Tag="Name" KeyDown="BoneField_KeyDown" LostFocus="BoneField_LostFocus" />

                                        <TextBlock Grid.Row="2" Text="Parent" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                                        <ComboBox x:Name="BoneParent" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,4"
                              SelectionChanged="BoneParent_Changed" />

                                        <TextBlock Grid.Row="3" Text="X / Y" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                                        <TextBox x:Name="BoneX" Grid.Row="3" Grid.Column="1" Margin="0,0,2,4"
                             Tag="X" KeyDown="BoneField_KeyDown" LostFocus="BoneField_LostFocus" />
                                        <TextBox x:Name="BoneY" Grid.Row="3" Grid.Column="2" Margin="2,0,0,4"
                             Tag="Y" KeyDown="BoneField_KeyDown" LostFocus="BoneField_LostFocus" />

                                        <TextBlock Grid.Row="4" Text="Rot° / Len" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                                        <TextBox x:Name="BoneRotation" Grid.Row="4" Grid.Column="1" Margin="0,0,2,4"
                             Tag="Rotation" KeyDown="BoneField_KeyDown" LostFocus="BoneField_LostFocus" />
                                        <TextBox x:Name="BoneLength" Grid.Row="4" Grid.Column="2" Margin="2,0,0,4"
                             Tag="Length" KeyDown="BoneField_KeyDown" LostFocus="BoneField_LostFocus" />

                                        <TextBlock Grid.Row="5" Text="Scale" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                                        <TextBox x:Name="BoneScaleX" Grid.Row="5" Grid.Column="1" Margin="0,0,2,4"
                             Tag="ScaleX" KeyDown="BoneField_KeyDown" LostFocus="BoneField_LostFocus" />
                                        <TextBox x:Name="BoneScaleY" Grid.Row="5" Grid.Column="2" Margin="2,0,0,4"
                             Tag="ScaleY" KeyDown="BoneField_KeyDown" LostFocus="BoneField_LostFocus" />

                                        <TextBlock Grid.Row="6" Text="Turn° / Tilt°" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                                        <TextBox x:Name="BoneTurn" Grid.Row="6" Grid.Column="1" Margin="0,0,2,4"
                             Tag="Turn" KeyDown="BoneField_KeyDown" LostFocus="BoneField_LostFocus"
                             ToolTip="Depth rotation around the bone's length: parts narrow, and mirror across the bone at 180°" />
                                        <TextBox x:Name="BoneTilt" Grid.Row="6" Grid.Column="2" Margin="2,0,0,4"
                             Tag="Tilt" KeyDown="BoneField_KeyDown" LostFocus="BoneField_LostFocus"
                             ToolTip="Depth rotation across the bone: it foreshortens, and mirrors along itself at 180°" />

                                        <WrapPanel Grid.Row="7" Grid.ColumnSpan="3" Margin="0,2,0,6">
                                            <CheckBox x:Name="BoneInheritRotation" Content="Inherit rotation" Foreground="White"
                                  Margin="0,0,10,4" Click="BoneInherit_Click" />
                                            <CheckBox x:Name="BoneInheritScale" Content="Inherit scale" Foreground="White"
                                  Margin="0,0,10,4" Click="BoneInherit_Click" />
                                            <CheckBox x:Name="BoneConnected" Content="On parent's end" Foreground="White"
                                  Click="BoneConnected_Click"
                                  ToolTip="The joint sits exactly on the parent bone's end, and stays there when the parent gets longer or shorter or the bone gets a new parent. Untick it, type X / Y, or drag the joint away to free it." />
                                        </WrapPanel>

                                        <TextBlock Grid.Row="8" Text="Look at" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                                        <ComboBox x:Name="LookTarget" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,4"
                              SelectionChanged="LookTarget_Changed"
                              ToolTip="Makes this bone (e.g. an iris) move toward the chosen bone, inside a boundary" />

                                        <TextBlock Grid.Row="9" Text="Shape / Follow" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                                        <ComboBox x:Name="LookShapeBox" Grid.Row="9" Grid.Column="1" Margin="0,0,2,4"
                              SelectionChanged="LookShape_Changed" />
                                        <TextBox x:Name="LookFollow" Grid.Row="9" Grid.Column="2" Margin="2,0,0,4"
                             Tag="Follow" KeyDown="BoneField_KeyDown" LostFocus="BoneField_LostFocus"
                             ToolTip="How strongly it follows: 0.1 = subtle, 1 = goes straight to the edge" />

                                        <TextBlock Grid.Row="10" Text="Range X / Y" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,6" />
                                        <TextBox x:Name="LookRangeX" Grid.Row="10" Grid.Column="1" Margin="0,0,2,6"
                             Tag="RangeX" KeyDown="BoneField_KeyDown" LostFocus="BoneField_LostFocus" />
                                        <TextBox x:Name="LookRangeY" Grid.Row="10" Grid.Column="2" Margin="2,0,0,6"
                             Tag="RangeY" KeyDown="BoneField_KeyDown" LostFocus="BoneField_LostFocus" />

                                        <TextBlock Grid.Row="11" Text="IK chain" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                                        <ComboBox x:Name="IkLength" Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,4"
                              SelectionChanged="IkLength_Changed"
                              ToolTip="Make this bone the END of an IK chain (hand, foot, tail tip). 2 bones = arm or leg, 1 = aim." />

                                        <TextBlock Grid.Row="12" Text="IK target" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                                        <ComboBox x:Name="IkTargetBox" Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,4"
                              SelectionChanged="IkTarget_Changed" />

                                        <StackPanel Grid.Row="13" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,2,0,4">
                                            <CheckBox x:Name="IkOn" Content="IK on" Foreground="White" Margin="0,0,10,0" Click="IkOptions_Click"
                                  ToolTip="Off = the chain plays its FK keys (same as the I key)" />
                                            <CheckBox x:Name="IkFlip" Content="Flip bend" Foreground="White" Click="IkOptions_Click"
                                  ToolTip="Which way the middle joint (elbow, knee) bends (same as the B key)" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="14" Text="Follows" Foreground="White" VerticalAlignment="Center" Margin="0,4,6,4" />
                                        <ComboBox x:Name="SpaceBox" Grid.Row="14" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,4"
                              SelectionChanged="SpaceBox_Changed"
                              ToolTip="What this bone follows from the current frame on (Animate mode). Detach it to drop or throw it, or attach it to another bone to be held." />

                                        <Button x:Name="ThrowButton" Grid.Row="15" Grid.ColumnSpan="3" Content="Throw / fall from this frame…" Margin="0,0,0,4"
                            Click="Throw_Click"
                            ToolTip="Detaches the bone here and bakes a thrown or falling flight into keys (Animate mode)" />

                                        <TextBlock x:Name="RigHint" Grid.Row="16" Grid.ColumnSpan="3" Foreground="#FF8080" TextWrapping="Wrap" />
                                    </Grid>
                                    <Grid x:Name="PartProps" Margin="6" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock x:Name="PartTitle" Grid.Row="0" Grid.ColumnSpan="3" Foreground="#9AA4B2"
                               TextWrapping="Wrap" Margin="0,0,0,6" />

                                        <TextBlock Grid.Row="1" Text="Name" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                                        <TextBox x:Name="PartName" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,4"
                             Tag="PName" KeyDown="PartField_KeyDown" LostFocus="PartField_LostFocus" />

                                        <TextBlock x:Name="PartBoneLabel" Grid.Row="2" Text="Bone" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                                        <ComboBox x:Name="PartBone" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,4"
                              SelectionChanged="PartBone_Changed"
                              ToolTip="Moves the part to another bone; it stays where it is on screen" />

                                        <TextBlock Grid.Row="3" Text="X / Y" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                                        <TextBox x:Name="PartX" Grid.Row="3" Grid.Column="1" Margin="0,0,2,4"
                             Tag="PX" KeyDown="PartField_KeyDown" LostFocus="PartField_LostFocus" />
                                        <TextBox x:Name="PartY" Grid.Row="3" Grid.Column="2" Margin="2,0,0,4"
                             Tag="PY" KeyDown="PartField_KeyDown" LostFocus="PartField_LostFocus" />

                                        <TextBlock Grid.Row="4" Text="Rotation°" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                                        <TextBox x:Name="PartRotation" Grid.Row="4" Grid.Column="1" Margin="0,0,2,4"
                             Tag="PRotation" KeyDown="PartField_KeyDown" LostFocus="PartField_LostFocus" />

                                        <TextBlock Grid.Row="5" Text="Scale" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                                        <TextBox x:Name="PartScaleX" Grid.Row="5" Grid.Column="1" Margin="0,0,2,4"
                             Tag="PScaleX" KeyDown="PartField_KeyDown" LostFocus="PartField_LostFocus" />
                                        <TextBox x:Name="PartScaleY" Grid.Row="5" Grid.Column="2" Margin="2,0,0,4"
                             Tag="PScaleY" KeyDown="PartField_KeyDown" LostFocus="PartField_LostFocus" />

                                        <TextBlock Grid.Row="6" Text="Pivot (px)" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                                        <TextBox x:Name="PartPivotX" Grid.Row="6" Grid.Column="1" Margin="0,0,2,4"
                             Tag="PPivotX" KeyDown="PartField_KeyDown" LostFocus="PartField_LostFocus"
                             ToolTip="Pixel of the image that rotation and scaling turn around (the image doesn't move)" />
                                        <TextBox x:Name="PartPivotY" Grid.Row="6" Grid.Column="2" Margin="2,0,0,4"
                             Tag="PPivotY" KeyDown="PartField_KeyDown" LostFocus="PartField_LostFocus" />

                                        <UniformGrid Grid.Row="7" Grid.ColumnSpan="3" Columns="3" Margin="0,4,0,4">
                                            <Button x:Name="EditPixelsButton" Content="Edit pixels" Margin="0,0,3,0" Click="EditPixels_Click" />
                                            <Button x:Name="PartFront" Content="▲ Front" Margin="3,0,3,0" Click="PartFront_Click"
                                ToolTip="Draw this part in front of one more part (Ctrl+]; Ctrl+Shift+] in front of all). In Animate mode, that keys the order." />
                                            <Button x:Name="PartBack" Content="▼ Back" Margin="3,0,0,0" Click="PartBack_Click"
                                ToolTip="Draw this part behind one more part (Ctrl+[; Ctrl+Shift+[ behind all). In Animate mode, that keys the order." />
                                        </UniformGrid>

                                        <!-- Frame-by-frame: the part's drawings -->
                                        <TextBlock Grid.Row="8" Grid.ColumnSpan="3" Text="Drawings (frame by frame)" Foreground="#9AA4B2" Margin="0,8,0,4" />

                                        <TextBlock Grid.Row="9" Text="Drawing" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                                        <ComboBox x:Name="DrawingBox" Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,4"
                              SelectionChanged="DrawingBox_Changed"
                              ToolTip="Animate mode: the drawing shown from this frame on (picking one keys it here). Setup mode: the part's rest drawing. (hidden) shows nothing." />

                                        <UniformGrid Grid.Row="10" Grid.ColumnSpan="3" Columns="3" Margin="0,0,0,4">
                                            <Button x:Name="NewDrawingButton" Content="New (F7)" Margin="0,0,3,0" Click="NewDrawing_Click"
                                ToolTip="A new, empty drawing with the same size and layers. Animate mode: shown from this frame on. Setup mode: becomes the rest drawing." />
                                            <Button x:Name="CopyDrawingButton" Content="Copy (F6)" Margin="3,0,3,0" Click="DuplicateDrawing_Click"
                                ToolTip="A copy of the current drawing, to change a little: the usual way to make the next frame" />
                                            <Button x:Name="DeleteDrawingButton" Content="Delete" Margin="3,0,0,0" Click="DeleteDrawing_Click"
                                ToolTip="Removes this drawing from the part, and its keys in every animation (undoable)" />
                                        </UniformGrid>

                                        <TextBlock Grid.Row="11" Text="Rename" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                                        <TextBox x:Name="DrawingName" Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,4"
                             KeyDown="DrawingName_KeyDown" LostFocus="DrawingName_LostFocus"
                             ToolTip="The current drawing's name (Enter to apply)" />

                                        <UniformGrid Grid.Row="12" Grid.ColumnSpan="3" Columns="2" Margin="0,0,0,4">
                                            <Button x:Name="ShorterButton" Content="◂ Shorter" Margin="0,0,3,0" Click="Shorter_Click"
                                ToolTip="Shift+F5: this drawing stays one frame less; the part's later drawings move one frame earlier (Animate mode)" />
                                            <Button x:Name="LongerButton" Content="Longer ▸" Margin="3,0,0,0" Click="Longer_Click"
                                ToolTip="F5: this drawing stays one frame more; the part's later drawings move one frame later (Animate mode)" />
                                        </UniformGrid>

                                        <!-- Effects (VFX): blend mode, tint and opacity -->
                                        <TextBlock Grid.Row="13" Grid.ColumnSpan="3" Text="Effects (VFX)" Foreground="#9AA4B2" Margin="0,8,0,4" />

                                        <TextBlock Grid.Row="14" Text="Blend" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                                        <ComboBox x:Name="BlendBox" Grid.Row="14" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,4"
                              SelectionChanged="BlendBox_Changed"
                              ToolTip="How the part mixes with what's behind it. Add = glow (sparks, flashes, magic), Multiply = shadow, Screen = soft light. Applies to the whole animation." />

                                        <TextBlock Grid.Row="15" Text="Colour / %" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                                        <Border Grid.Row="15" Grid.Column="1" Height="22" Margin="0,0,2,4" BorderBrush="White" BorderThickness="1"
                            Background="{StaticResource CheckerBrush}" Cursor="Hand" MouseLeftButtonUp="PartColorSwatch_Click"
                            ToolTip="Tint: multiplies the drawing's colours (white = as drawn). Click to pick. Animate mode: sets a colour key here.">
                                            <Rectangle x:Name="PartColorSwatch" />
                                        </Border>
                                        <TextBox x:Name="PartOpacity" Grid.Row="15" Grid.Column="2" Margin="2,0,0,4"
                             KeyDown="PartOpacity_KeyDown" LostFocus="PartOpacity_LostFocus"
                             ToolTip="Opacity in %: 100 = solid, 0 = invisible. Animate mode: typing sets a key here (fade in / out)." />

                                        <TextBlock x:Name="PartHint" Grid.Row="16" Grid.ColumnSpan="3" Foreground="#FF8080" TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </DockPanel>

                <!-- ===== Viewport ===== -->
                <Grid>
                    <skia:SKElement x:Name="Viewport" Focusable="True" FocusVisualStyle="{x:Null}" PaintSurface="OnPaintSurface"
                        MouseDown="Viewport_MouseDown" MouseMove="Viewport_MouseMove" MouseLeave="Viewport_MouseLeave"
                        MouseUp="Viewport_MouseUp" MouseWheel="Viewport_MouseWheel" />
                    <TextBlock x:Name="Status" Foreground="White" Margin="10"
                   VerticalAlignment="Bottom" IsHitTestVisible="False" TextWrapping="Wrap" />
                    <TextBlock x:Name="EventFlash" Foreground="#8CE6A0" FontSize="16" FontWeight="Bold" Margin="12"
                   HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False" />
                    <!-- The viewport's tools (inside an object), as in Blender -->
                    <StackPanel x:Name="ViewToolBar" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,24,0,0">
                        <RadioButton x:Name="SelectToolButton" Tag="Select" GroupName="ViewTool" Style="{StaticResource {x:Type ToggleButton}}"
                                     Width="30" Height="28" Margin="0,0,0,2" Checked="ViewTool_Checked" FontSize="15" Content="⬚" IsChecked="True" />
                        <RadioButton x:Name="MoveToolButton" Tag="Move" GroupName="ViewTool" Style="{StaticResource {x:Type ToggleButton}}"
                                     Width="30" Height="28" Margin="0,0,0,2" Checked="ViewTool_Checked" FontSize="15" Content="✥" />
                        <RadioButton x:Name="RotateToolButton" Tag="Rotate" GroupName="ViewTool" Style="{StaticResource {x:Type ToggleButton}}"
                                     Width="30" Height="28" Margin="0,0,0,2" Checked="ViewTool_Checked" FontSize="15" Content="⟳" />
                        <RadioButton x:Name="PaintToolButton" Tag="Paint" GroupName="ViewTool" Style="{StaticResource {x:Type ToggleButton}}"
                                     Width="30" Height="28" Checked="ViewTool_Checked" FontSize="15" Content="✎" />
                    </StackPanel>
                </Grid>
            </DockPanel>

            <GridSplitter x:Name="PaintSplitter" Grid.Row="0" Grid.Column="1" Width="5"
                      HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                      Background="#1B1D22" Visibility="Collapsed" />

        <DockPanel x:Name="PaintPanel" Grid.Row="0" Grid.Column="2" Background="#24272E" Visibility="Collapsed">

            <DockPanel DockPanel.Dock="Top" Margin="6">
                <Button x:Name="ClosePaintButton" Content="Close (Esc)" DockPanel.Dock="Right" Padding="8,2" Click="ClosePaint_Click" />
                <Button Content="Canvas size…" DockPanel.Dock="Right" Padding="8,2" Margin="0,0,6,0" Click="CanvasSize_Click" />
                <TextBlock x:Name="PaintTitle" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" />
            </DockPanel>

            <WrapPanel x:Name="ToolButtons" DockPanel.Dock="Top" Margin="6,0,6,6">
                <RadioButton Content="Select (M)" Tag="Select" GroupName="PaintTools" Click="Tool_Click"
                             Style="{StaticResource {x:Type ToggleButton}}" Padding="6,2" Margin="0,0,4,4"
                             ToolTip="Select by shape (rectangle, ellipse, polygon, freehand…). Shift = add, Alt = subtract" />
                <RadioButton Content="Wand (W)" Tag="Wand" GroupName="PaintTools" Click="Tool_Click"
                             Style="{StaticResource {x:Type ToggleButton}}" Padding="6,2" Margin="0,0,4,4"
                             ToolTip="Magic wand: click a colour to select it (uses Tolerance). Shift = add, Alt = subtract" />
                <RadioButton Content="Move (V)" Tag="Move" GroupName="PaintTools" Click="Tool_Click"
                             Style="{StaticResource {x:Type ToggleButton}}" Padding="6,2" Margin="0,0,4,4" />
                <RadioButton Content="Pencil (N)" Tag="Pencil" GroupName="PaintTools" Click="Tool_Click"
                             Style="{StaticResource {x:Type ToggleButton}}" Padding="6,2" Margin="0,0,4,4" />
                <RadioButton Content="Brush (B)" Tag="Brush" GroupName="PaintTools" Click="Tool_Click"
                             Style="{StaticResource {x:Type ToggleButton}}" Padding="6,2" Margin="0,0,4,4" />
                <RadioButton Content="Mixer (X)" Tag="Mixer" GroupName="PaintTools" Click="Tool_Click"
                             Style="{StaticResource {x:Type ToggleButton}}" Padding="6,2" Margin="0,0,4,4" />
                <RadioButton Content="Eraser (E)" Tag="Eraser" GroupName="PaintTools" Click="Tool_Click"
                             Style="{StaticResource {x:Type ToggleButton}}" Padding="6,2" Margin="0,0,4,4" />
                <RadioButton Content="Picker (I)" Tag="Picker" GroupName="PaintTools" Click="Tool_Click"
                             Style="{StaticResource {x:Type ToggleButton}}" Padding="6,2" Margin="0,0,4,4" />
                <RadioButton Content="Fill (G)" Tag="Fill" GroupName="PaintTools" Click="Tool_Click"
                             Style="{StaticResource {x:Type ToggleButton}}" Padding="6,2" Margin="0,0,4,4" />
                <RadioButton Content="Gradient (D)" Tag="Gradient" GroupName="PaintTools" Click="Tool_Click"
                             Style="{StaticResource {x:Type ToggleButton}}" Padding="6,2" Margin="0,0,4,4" />
                <RadioButton Content="Figure (U)" Tag="Figure" GroupName="PaintTools" Click="Tool_Click"
                             Style="{StaticResource {x:Type ToggleButton}}" Padding="6,2" Margin="0,0,4,4" />
            </WrapPanel>

            <!-- Colours, and the selection (it limits what every tool paints) -->
            <WrapPanel DockPanel.Dock="Top" Margin="6,0,6,6">
                <Grid Width="38" Height="34" Margin="0,0,4,0"
          ToolTip="Primary (front) and secondary (back). Click one to pick any colour, with transparency. Right-click a palette colour to set the secondary.">
                    <Border Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                BorderBrush="White" BorderThickness="1" Background="{StaticResource CheckerBrush}"
                Cursor="Hand" MouseLeftButtonUp="SecondarySwatch_Click">
                        <Rectangle x:Name="SecondarySwatch" />
                    </Border>
                    <Border Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Top"
                BorderBrush="White" BorderThickness="1" Background="{StaticResource CheckerBrush}"
                Cursor="Hand" MouseLeftButtonUp="ColorSwatch_Click">
                        <Rectangle x:Name="ColorSwatch" />
                    </Border>
                </Grid>
                <Button x:Name="SwapColorsButton" Content="⇄" ToolTip="Swap colors (S)" Padding="5,0" Margin="0,0,6,0" Click="SwapColors_Click" />
                <TextBox x:Name="ColorHex" Width="86" VerticalContentAlignment="Center"
             LostFocus="ColorHex_Commit" KeyDown="ColorHex_KeyDown" ToolTip="#RRGGBB or #AARRGGBB" />
                <Button x:Name="InvertSelectionButton" Content="Invert selection" Padding="6,0" Margin="12,0,0,0" Click="InvertSelection_Click"
                        ToolTip="Select everything that isn't selected (Ctrl+Shift+I)" />
                <Button x:Name="DeselectButton" Content="Deselect" Padding="6,0" Margin="4,0,0,0" Click="Deselect_Click"
                        ToolTip="Drop the selection, so tools work everywhere again (Ctrl+D)" />
            </WrapPanel>

            <!-- The current tool's options: only the ones it uses are shown -->
            <WrapPanel x:Name="ToolOptions" DockPanel.Dock="Top" Margin="6,0,6,2" MinHeight="26">
                <TextBlock x:Name="ToolOptionsTitle" Foreground="#9AA4B2" VerticalAlignment="Center" Margin="0,0,10,4" />

                <StackPanel x:Name="SizeOption" Orientation="Horizontal" Margin="0,0,14,4">
                    <TextBlock Text="Size" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <Slider x:Name="SizeSlider" Width="110" Minimum="1" Maximum="64" Value="4"
                IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                ValueChanged="SizeSlider_Changed" ToolTip="[ and ] change it too" />
                    <TextBlock x:Name="SizeLabel" Foreground="White" Width="24" Margin="4,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel x:Name="ToleranceOption" Orientation="Horizontal" Margin="0,0,14,4">
                    <TextBlock Text="Tolerance" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0"
                   ToolTip="How different a colour may be and still count as the same" />
                    <Slider x:Name="ToleranceSlider" Width="120" Minimum="0" Maximum="255" Value="24"
                IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                ValueChanged="ToleranceSlider_Changed"
                ToolTip="0 = only that exact colour. 255 = everything that isn't fully see-through" />
                    <TextBlock x:Name="ToleranceLabel" Foreground="White" Width="26" Margin="4,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <CheckBox x:Name="ContiguousBox" Content="Contiguous" Foreground="White" IsChecked="True"
              VerticalAlignment="Center" Margin="0,0,14,4" Click="Contiguous_Click"
              ToolTip="On: only the area connected to where you click. Off: that colour everywhere on the layer (Photoshop's &quot;Contiguous&quot;)" />
                <CheckBox x:Name="SampleAllBox" Content="Sample all layers" Foreground="White"
              VerticalAlignment="Center" Margin="0,0,14,4" Click="SampleAll_Click"
              ToolTip="Look at the merged image instead of only this layer (the result still goes on this layer)" />

                <StackPanel x:Name="MixOptions" Orientation="Horizontal" Margin="0,0,14,4">
                    <TextBlock Text="Wet" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <Slider x:Name="WetSlider" Width="100" Minimum="0" Maximum="100" Value="50"
                VerticalAlignment="Center" ValueChanged="MixSliders_Changed"
                ToolTip="How much paint the brush picks up from the canvas" />
                    <TextBlock Text="Load" Foreground="White" VerticalAlignment="Center" Margin="12,0,4,0" />
                    <Slider x:Name="LoadSlider" Width="100" Minimum="0" Maximum="100" Value="20"
                VerticalAlignment="Center" ValueChanged="MixSliders_Changed"
                ToolTip="How quickly the brush refills with your colour (0 = smudge)" />
                </StackPanel>

                <CheckBox x:Name="GradientTransparentBox" Content="To transparent" Foreground="White"
              VerticalAlignment="Center" Margin="0,0,14,4" Click="GradientTransparent_Click"
              ToolTip="Off: primary → secondary colour. On: primary → transparent." />

                <StackPanel x:Name="SelectShapeOption" Orientation="Horizontal" Margin="0,0,14,4">
                    <TextBlock Text="Shape" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ComboBox x:Name="SelectShapeBox" Width="100" SelectionChanged="SelectShape_Changed"
                  ToolTip="Polygon, Polyline and Curve: click points, double-click or Enter to finish" />
                </StackPanel>
                <StackPanel x:Name="SelectModeOption" Orientation="Horizontal" Margin="0,0,14,4">
                    <TextBlock Text="Mode" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ComboBox x:Name="SelectModeBox" Width="90" SelectionChanged="SelectMode_Changed"
                  ToolTip="How a new selection combines with the current one. Holding Shift (add), Alt (subtract) or both (intersect) overrides this" />
                </StackPanel>

                <StackPanel x:Name="FigureOptions" Orientation="Horizontal" Margin="0,0,14,4">
                    <ComboBox x:Name="FigureShapeBox" Width="100" SelectionChanged="FigureShape_Changed" />
                    <ComboBox x:Name="FigureStyleBox" Width="120" Margin="8,0,0,0" SelectionChanged="FigureStyle_Changed" />
                    <CheckBox x:Name="FigureSmoothBox" Content="Smooth edges" Foreground="White" IsChecked="True"
                  VerticalAlignment="Center" Margin="12,0,0,0" Click="FigureOption_Click" />
                    <StackPanel x:Name="SidesOption" Orientation="Horizontal" Margin="12,0,0,0">
                        <TextBlock Text="Sides" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <Slider x:Name="SidesSlider" Width="80" Minimum="3" Maximum="12" Value="5"
                    IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                    ValueChanged="SidesSlider_Changed" />
                        <TextBlock x:Name="SidesLabel" Foreground="White" Width="20" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </WrapPanel>

            <WrapPanel x:Name="Palette" DockPanel.Dock="Top" Margin="6,0,6,6" />

            <DockPanel DockPanel.Dock="Right" Width="190" Margin="0,0,6,6">
                <TextBlock DockPanel.Dock="Top" Text="Layers (top first)" Foreground="White" Margin="0,0,0,4" />
                <ScrollViewer DockPanel.Dock="Bottom" MaxHeight="320" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                    <StackPanel x:Name="LayerAdjustHost" />
                </ScrollViewer>
                <Button DockPanel.Dock="Bottom" Content="+ Colour layer ▾" Margin="0,4,0,0" Click="LayerAddColour_Click"
                        ToolTip="A colour layer: it changes the colours of the layers under it, in this drawing only (and can be keyed in Animate mode)" />
                <UniformGrid DockPanel.Dock="Bottom" Columns="4" Margin="0,4,0,0">
                    <Button Content="+" ToolTip="Add layer" Click="LayerAdd_Click" />
                    <Button Content="−" ToolTip="Delete layer" Click="LayerDelete_Click" />
                    <Button Content="▲" ToolTip="Move layer up" Click="LayerUp_Click" />
                    <Button Content="▼" ToolTip="Move layer down" Click="LayerDown_Click" />
                </UniformGrid>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                    <TextBox x:Name="LayerName" ToolTip="Layer name (Enter to apply)"
                             KeyDown="LayerName_KeyDown" LostFocus="LayerName_Commit" />
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="Opacity" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Slider x:Name="LayerOpacity" Minimum="0" Maximum="100" Value="100"
                                VerticalAlignment="Center" ValueChanged="LayerOpacity_Changed" />
                    </DockPanel>
                </StackPanel>
                <ListBox x:Name="LayerList" Background="#1E2026" Foreground="White"
                         SelectionChanged="LayerList_SelectionChanged" />
            </DockPanel>

            <skia:SKElement x:Name="PaintView" Cursor="Cross"
                            Focusable="True" FocusVisualStyle="{x:Null}" PaintSurface="OnPaintViewPaint"
                            MouseDown="PaintView_MouseDown" MouseMove="PaintView_MouseMove"
                            MouseUp="PaintView_MouseUp" MouseWheel="PaintView_MouseWheel"
                            MouseLeave="PaintView_MouseLeave" />
        </DockPanel>

            <DockPanel Grid.Row="1" Grid.ColumnSpan="3">
                <WrapPanel DockPanel.Dock="Top" Background="#24272E">
                    <!-- The open object's animations (disabled at scene level) -->
                    <StackPanel x:Name="AnimControls" Orientation="Horizontal">
                        <TextBlock Text="Animation" Foreground="White" VerticalAlignment="Center" Margin="8,4,6,4" />
                        <ComboBox x:Name="AnimList" Width="160" Margin="0,4,6,4" DisplayMemberPath="Name"
                      SelectionChanged="AnimList_Changed" />
                        <Button Content="+ New" Padding="6,1" Margin="0,4,4,4" Click="AnimNew_Click" />
                        <Button Content="Duplicate" Padding="6,1" Margin="0,4,4,4" Click="AnimDuplicate_Click" />
                        <Button x:Name="AnimDeleteButton" Content="Delete" Padding="6,1" Margin="0,4,14,4" Click="AnimDelete_Click" />

                        <TextBlock Text="Name" Foreground="White" VerticalAlignment="Center" Margin="0,4,4,4" />
                        <TextBox x:Name="AnimName" Width="130" Margin="0,4,12,4" VerticalContentAlignment="Center"
                     Tag="Name" KeyDown="AnimField_KeyDown" LostFocus="AnimField_LostFocus" />
                        <TextBlock Text="Length (frames)" Foreground="White" VerticalAlignment="Center" Margin="0,4,4,4" />
                        <TextBox x:Name="AnimLength" Width="50" Margin="0,4,12,4" VerticalContentAlignment="Center"
                     Tag="Length" KeyDown="AnimField_KeyDown" LostFocus="AnimField_LostFocus" />
                        <CheckBox x:Name="AnimLoop" Content="Loop" Foreground="White" VerticalAlignment="Center"
                      Margin="0,4,12,4" Click="AnimLoop_Click" />
                        <CheckBox x:Name="AutoKeyBox" Content="Auto key" Foreground="White" VerticalAlignment="Center"
                      Margin="0,4,4,4" Click="AutoKey_Click"
                      ToolTip="On: posing in Animate mode sets keys. Off: it only changes the pose (an empty orange key shows where), until Key keys it; going to another frame drops what wasn't keyed." />
                        <Button x:Name="KeyPoseButton" Content="Key" Padding="6,1" Margin="0,4,12,4" Click="KeyPose_Click"
                    ToolTip="Keys the pose at the playhead: the changes not keyed yet (auto key off), or else the picked bones' and parts' whole pose" />
                        <CheckBox x:Name="GraphBox" Content="Curves" Foreground="White" VerticalAlignment="Center"
                      Margin="0,4,12,4" Click="Graph_Click"
                      ToolTip="The graph editor: the keys' numbers as curves over time (the picked bones and parts, or the selected keys). Drag a key to move it, its square handles to ease the stretch from it (Bézier)." />
                        <CheckBox x:Name="OnlyPickedBox" Content="Only the picked's rows" Foreground="White" VerticalAlignment="Center"
                      Margin="0,4,12,4" Click="OnlyPicked_Click"
                      ToolTip="With bones or parts picked, the timeline shows just their rows (and the events and stacking order)" />
                    </StackPanel>
                    <!-- At scene level: the scene timeline's settings -->
                    <StackPanel x:Name="SceneControls" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="Scene" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="8,4,10,4" />
                        <TextBlock Text="Length (frames)" Foreground="White" VerticalAlignment="Center" Margin="0,4,4,4" />
                        <TextBox x:Name="SceneLength" Width="50" Margin="0,4,6,4" VerticalContentAlignment="Center"
                     Tag="SLength" KeyDown="SceneField_KeyDown" LostFocus="SceneField_LostFocus"
                     ToolTip="How long the scene timeline runs" />
                        <Button Content="Fit to clips" Padding="6,1" Margin="0,4,12,4" Click="FitSceneToClips_Click"
                    ToolTip="Makes the scene end where its last clip ends" />
                        <CheckBox x:Name="SceneLoopBox" Content="Loop" Foreground="White" VerticalAlignment="Center"
                      Margin="0,4,12,4" Click="SceneLoop_Click" ToolTip="Plays the scene again from the start when it ends" />
                        <TextBlock Text="Stage" Foreground="White" VerticalAlignment="Center" Margin="0,4,4,4"
                       ToolTip="The picture the scene is made for (its video size), centred on the scene's origin. 0 × 0 = none." />
                        <TextBox x:Name="StageWidthBox" Width="50" Margin="0,4,2,4" VerticalContentAlignment="Center"
                     Tag="SWidth" KeyDown="SceneField_KeyDown" LostFocus="SceneField_LostFocus" ToolTip="Stage width (0 = no stage)" />
                        <TextBlock Text="×" Foreground="White" VerticalAlignment="Center" Margin="2,4,2,4" />
                        <TextBox x:Name="StageHeightBox" Width="50" Margin="2,4,12,4" VerticalContentAlignment="Center"
                     Tag="SHeight" KeyDown="SceneField_KeyDown" LostFocus="SceneField_LostFocus" ToolTip="Stage height (0 = no stage)" />
                    </StackPanel>
                    <TextBlock Text="FPS" Foreground="White" VerticalAlignment="Center" Margin="0,4,4,4" />
                    <TextBox x:Name="AnimFps" Width="40" Margin="0,4,12,4" VerticalContentAlignment="Center"
                 Tag="Fps" KeyDown="AnimField_KeyDown" LostFocus="AnimField_LostFocus"
                 ToolTip="Frames per second for the whole project. Timing is kept in seconds." />
                    <TextBlock Text="Speed" Foreground="White" VerticalAlignment="Center" Margin="0,4,4,4" />
                    <ComboBox x:Name="SpeedBox" Width="58" Margin="0,4,4,4" SelectionChanged="Speed_Changed"
                  ToolTip="How fast play goes (the animation itself doesn't change)" />
                    <Button x:Name="PlaybackButton" Content="Playback ▾" Padding="6,1" Margin="0,4,12,4" Click="PlaybackMenu_Click"
                    ToolTip="Back and forth, the picked frames over and over, and where stopping leaves the playhead" />
                    <CheckBox x:Name="OnionBox" Content="Onion skin (O)" Foreground="White" VerticalAlignment="Center"
                  Margin="0,4,6,4" Click="Onion_Click"
                  ToolTip="Faint copies of the neighbouring frames: red = before, blue = after. In the paint editor: the part's previous and next drawings, under the one you paint." />
                    <TextBlock Text="before" Foreground="White" VerticalAlignment="Center" Margin="0,4,4,4" />
                    <ComboBox x:Name="OnionBefore" Width="42" Margin="0,4,6,4" SelectionChanged="OnionSettings_Changed" />
                    <TextBlock Text="after" Foreground="White" VerticalAlignment="Center" Margin="0,4,4,4" />
                    <ComboBox x:Name="OnionAfter" Width="42" Margin="0,4,6,4" SelectionChanged="OnionSettings_Changed" />
                    <TextBlock Text="every" Foreground="White" VerticalAlignment="Center" Margin="0,4,4,4" />
                    <ComboBox x:Name="OnionStep" Width="42" Margin="0,4,12,4" SelectionChanged="OnionSettings_Changed"
                  ToolTip="Viewport ghosts: every Nth frame (2 = for animating on twos)" />
                    <TextBlock x:Name="AnimHint" Foreground="#FF8080" VerticalAlignment="Center" Margin="0,4,8,4" />
                </WrapPanel>

                <skia:SKElement x:Name="TimelineView" Focusable="True" FocusVisualStyle="{x:Null}" PaintSurface="OnTimelinePaint"
                    MouseDown="Timeline_MouseDown" MouseMove="Timeline_MouseMove"
                    MouseUp="Timeline_MouseUp" MouseWheel="Timeline_MouseWheel" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>