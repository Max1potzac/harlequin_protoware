<Application x:Class="Animator.Viewer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Animator.Viewer">
    <Application.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Theming/Controls.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <!-- Grey checkerboard, shown behind colours so transparency is visible -->
        <DrawingBrush x:Key="CheckerBrush" TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#C8C8C8" Geometry="M0,0 H2 V2 H0 Z" />
                    <GeometryDrawing Brush="#A0A0A0" Geometry="M0,0 H1 V1 H0 Z M1,1 H2 V2 H1 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        </ResourceDictionary>
    </Application.Resources>
</Application>
