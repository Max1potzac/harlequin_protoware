<Window x:Class="Animator.Viewer.Dialogs.XflImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="Import an Animate project" Width="1240" Height="840" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" PreviewKeyDown="Window_KeyDown" Closed="Window_Closed">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="280" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="460" MinWidth="330" />
        </Grid.ColumnDefinitions>

        <!-- ===== The picture, and the frames under it ===== -->
        <DockPanel Grid.Column="0">
            <DockPanel DockPanel.Dock="Bottom" Margin="8,4,8,8">
                <Button x:Name="PlayButton" DockPanel.Dock="Left" Content="▶" Width="32" Margin="0,0,8,0" Click="Play_Click"
                        ToolTip="Play the timeline (Space)" />
                <TextBlock x:Name="FrameText" DockPanel.Dock="Right" Width="150" VerticalAlignment="Center" Margin="8,0,0,0" />
                <Slider x:Name="FrameSlider" Minimum="0" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1"
                        VerticalAlignment="Center" ValueChanged="FrameSlider_Changed" />
            </DockPanel>
            <Grid>
                <skia:SKElement x:Name="PreviewView" Focusable="True" PaintSurface="PreviewView_Paint"
                                MouseDown="PreviewView_MouseDown" MouseMove="PreviewView_MouseMove"
                                MouseUp="PreviewView_MouseUp" MouseWheel="PreviewView_MouseWheel" />
                <TextBlock x:Name="ViewHint" Text="Click: pick a part   Wheel: zoom   Middle drag: move around   Home: fit   Space: play"
                           Foreground="#9AA4B2" Margin="8" VerticalAlignment="Bottom" TextWrapping="Wrap" IsHitTestVisible="False" />
            </Grid>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      Background="#D0D0D0" ToolTip="Drag to give the settings or the picture more room" />

        <!-- ===== Settings ===== -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="10">
                <TextBlock x:Name="FileTitle" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock x:Name="NotesText" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0" />

                <!-- Timeline and animations -->
                <TextBlock Text="Timeline" FontWeight="Bold" Margin="0,12,0,4" />
                <ComboBox x:Name="TimelineBox" SelectionChanged="Timeline_Changed"
                          ToolTip="A scene, or a symbol with its own animation (a character in a bigger scene, say)" />
                <TextBlock x:Name="TimelineText" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0" />
                <CheckBox x:Name="SplitBox" Margin="0,6,0,0" Click="Split_Click"
                          ToolTip="Each label starts an animation that runs to the next label (idle, walk, attack…). Without it, the whole timeline is one animation.">
                    <TextBlock Text="An animation for each frame label" TextWrapping="Wrap" />
                </CheckBox>

                <!-- Parts -->
                <TextBlock Text="Parts" FontWeight="Bold" Margin="0,14,0,4" />
                <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Each thing that moves on its own becomes a part (the top one is at the top here). In: bring it in. Rig: use it to work out the rig; untick skins, extras and things shown alongside their alternatives, and they'll ride on the bone they move with. FX: an effect (VFX), such as crumbs, splashes or sparks: left out of the rig, it moves on its own and is hidden at rest. Parts that only show for a moment start as effects." />
                <CheckBox x:Name="FollowBox" Margin="0,0,0,6" Click="Follow_Click"
                          ToolTip="For projects where a part moves to another layer from one animation to the next, or a layer shows something else for a while (the way converters write PvZ2 animations). Without it, each layer is a part. It starts ticked when the project looks that way.">
                    <TextBlock Text="Parts follow their drawings from layer to layer" TextWrapping="Wrap" />
                </CheckBox>
                <Grid Margin="5,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="In" FontSize="10" Foreground="Gray" ToolTip="Bring it in" />
                    <TextBlock Grid.Column="1" Text="Rig" FontSize="10" Foreground="Gray" ToolTip="Use it to work out the rig" />
                    <TextBlock Grid.Column="2" Text="FX" FontSize="10" Foreground="Gray" ToolTip="An effect (VFX)" />
                    <TextBlock Grid.Column="3" Text="Part (hover it for the layers it's on)" FontSize="10" Foreground="Gray" />
                </Grid>
                <ListBox x:Name="PartList" MinHeight="120" MaxHeight="420" SelectionChanged="PartList_Changed"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" />
                <UniformGrid Columns="2" Margin="0,4,0,0">
                    <Button Content="Bring them all in" Margin="0,0,3,0" Click="TickAll_Click" />
                    <Button Content="Only the visible ones" Margin="3,0,0,0" Click="TickVisible_Click"
                            ToolTip="Brings in the parts on layers shown in Animate, and leaves out the ones on hidden layers" />
                </UniformGrid>

                <!-- Rig -->
                <TextBlock Text="Rig" FontWeight="Bold" Margin="0,14,0,4" />
                <CheckBox x:Name="RigBox" Click="Rig_Click"
                          ToolTip="Bones where the parts turn around each other, keyed to move as they did. Without it, the project comes in as a drawn object: its parts, moving on their own.">
                    <TextBlock Text="Suggest a rig from the animation" TextWrapping="Wrap" />
                </CheckBox>
                <StackPanel x:Name="RigFields" Margin="0,6,0,0">
                    <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="Parts that turn around a point they share get bones jointed there; details lying on another part ride on its bone. Change any of it below; the picture shows it on the rest pose." />
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="Rest pose" VerticalAlignment="Center" Width="70"
                                   ToolTip="The frame whose pose the rig is fitted to and the parts rest in" />
                        <Button DockPanel.Dock="Right" Content="Use the frame shown" Padding="6,1" Click="UseFrame_Click" />
                        <TextBlock x:Name="SetupText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock x:Name="RigAnimationsLabel" Text="Worked out from these animations:" Margin="0,0,0,2" TextWrapping="Wrap"
                               ToolTip="Untick animations where parts come apart (a head falling off, an arm dropping): they'd hide the joints the others show" />
                    <WrapPanel x:Name="RigAnimations" Margin="0,0,0,6" />
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="Root" VerticalAlignment="Center" Width="70"
                                   ToolTip="The bone everything else hangs from: usually the body" />
                        <ComboBox x:Name="RootBox" SelectionChanged="Root_Changed" />
                    </DockPanel>
                    <Border BorderBrush="#A0A0A0" BorderThickness="1" Padding="8" Margin="0,0,0,6">
                        <StackPanel x:Name="PartFields">
                            <TextBlock x:Name="PartTitle" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <RadioButton x:Name="OwnBoneChoice" GroupName="Role" Checked="Role_Changed">
                                <TextBlock Text="Its own bone (a part that bends or turns)" TextWrapping="Wrap" />
                            </RadioButton>
                            <RadioButton x:Name="OnBoneChoice" GroupName="Role" Margin="0,4,0,0" Checked="Role_Changed">
                                <TextBlock Text="No bone: it rides on another part's bone" TextWrapping="Wrap" />
                            </RadioButton>
                            <RadioButton x:Name="EffectChoice" GroupName="Role" Margin="0,4,0,0" Checked="Role_Changed"
                                         ToolTip="Crumbs, splashes, sparks: left out of the rig, it moves on the object's own bone, keyed where it goes, and is hidden at rest">
                                <TextBlock Text="An effect (VFX): no bone, it moves on its own" TextWrapping="Wrap" />
                            </RadioButton>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock x:Name="TargetLabel" Text="Hangs from" VerticalAlignment="Center" Width="70" />
                                <ComboBox x:Name="TargetBox" SelectionChanged="Target_Changed" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Button Content="Suggest the roles again" HorizontalAlignment="Left" Padding="8,1" Click="SuggestRoles_Click"
                            ToolTip="Forgets the changes above and works out each part's role from the shapes and the motion again (and which parts are effects: the ones that only show for a moment)" />
                </StackPanel>

                <!-- Size -->
                <TextBlock Text="Size" FontWeight="Bold" Margin="0,14,0,4" />
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="ScaleBox" Width="50" LostFocus="Scale_Changed" KeyDown="Scale_KeyDown"
                             ToolTip="Big projects can come in smaller: 50 = half the size, in pixels and in placement" />
                    <TextBlock Text="% of the project's size" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>

                <TextBlock x:Name="Summary" TextWrapping="Wrap" Margin="0,14,0,0" />
                <TextBlock x:Name="ErrorText" Foreground="#C03030" TextWrapping="Wrap" Margin="0,4,0,0" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Import" IsDefault="True" Width="80" Margin="0,0,6,0" Click="Import_Click" />
                    <Button Content="Cancel" IsCancel="True" Width="75" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
