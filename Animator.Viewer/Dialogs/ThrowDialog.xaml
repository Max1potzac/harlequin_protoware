<Window x:Class="Animator.Viewer.Dialogs.ThrowDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Throw / Fall" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="14">
        <TextBlock x:Name="Heading" TextWrapping="Wrap" MaxWidth="320" Margin="0,0,0,10" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Launch speed X / Y" Margin="0,0,10,6" VerticalAlignment="Center" />
            <TextBox x:Name="SpeedXBox" Grid.Row="0" Grid.Column="1" Margin="0,0,3,6"
                     ToolTip="Sideways speed at the launch, per second. Negative = to the left." />
            <TextBox x:Name="SpeedYBox" Grid.Row="0" Grid.Column="2" Margin="3,0,0,6"
                     ToolTip="Upward speed at the launch, per second. 0 = just drops." />

            <TextBlock Grid.Row="1" Text="Spin (° per second)" Margin="0,0,10,6" VerticalAlignment="Center" />
            <TextBox x:Name="SpinBox" Grid.Row="1" Grid.Column="1" Margin="0,0,3,6"
                     ToolTip="Positive turns counter-clockwise, negative clockwise." />

            <TextBlock Grid.Row="2" Text="Gravity" Margin="0,0,10,6" VerticalAlignment="Center" />
            <TextBox x:Name="GravityBox" Grid.Row="2" Grid.Column="1" Margin="0,0,3,6"
                     ToolTip="How hard it's pulled down, per second squared. Bigger = falls faster." />

            <TextBlock Grid.Row="3" Text="Ground height" Margin="0,0,10,6" VerticalAlignment="Center" />
            <TextBox x:Name="GroundBox" Grid.Row="3" Grid.Column="1" Margin="0,0,3,6"
                     ToolTip="World Y of the floor it lands on. Starts at the character's lowest point." />

            <TextBlock Grid.Row="4" Text="Bounce (0–1)" Margin="0,0,10,6" VerticalAlignment="Center" />
            <TextBox x:Name="BounceBox" Grid.Row="4" Grid.Column="1" Margin="0,0,3,6"
                     ToolTip="0 = lands with a thud, 1 = bounces back as high as it fell." />

            <TextBlock Grid.Row="5" Text="Friction (0–1)" Margin="0,0,10,6" VerticalAlignment="Center" />
            <TextBox x:Name="FrictionBox" Grid.Row="5" Grid.Column="1" Margin="0,0,3,6"
                     ToolTip="How quickly it stops sliding and spinning on the floor. 0 = never." />

            <TextBlock Grid.Row="6" Text="Key every (frames)" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBox x:Name="KeyEveryBox" Grid.Row="6" Grid.Column="1" Margin="0,0,3,0"
                     ToolTip="1 = a key on every frame (most exact), higher = fewer keys to edit afterwards." />
        </Grid>

        <TextBlock Foreground="Gray" TextWrapping="Wrap" MaxWidth="320" Margin="0,10,0,0"
                   Text="The bone is detached at this frame if it isn't already, and its later keys are replaced by the flight. Everything attached to it falls along. Undo removes it all." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Throw" IsDefault="True" Width="75" Margin="0,0,6,0" Click="Ok_Click" />
            <Button Content="Cancel" IsCancel="True" Width="75" />
        </StackPanel>
    </StackPanel>
</Window>
