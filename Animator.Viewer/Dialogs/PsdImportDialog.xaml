<Window x:Class="Animator.Viewer.Dialogs.PsdImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="Import a Photoshop file" Width="1180" Height="820" MinWidth="740" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" PreviewKeyDown="Window_KeyDown" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="280" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="420" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <!-- ===== The picture ===== -->
        <Grid Grid.Column="0">
            <skia:SKElement x:Name="PreviewView" Focusable="True" PaintSurface="PreviewView_Paint"
                            MouseDown="PreviewView_MouseDown" MouseMove="PreviewView_MouseMove"
                            MouseUp="PreviewView_MouseUp" MouseWheel="PreviewView_MouseWheel" />
            <TextBlock Text="Click: pick a layer   Wheel: zoom   Middle drag: move around   Home: fit" Foreground="{DynamicResource TextMutedBrush}"
                       Margin="8" VerticalAlignment="Bottom" TextWrapping="Wrap" IsHitTestVisible="False" />
        </Grid>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      Background="{DynamicResource BorderBrush}" ToolTip="Drag to give the settings or the picture more room" />

        <!-- ===== Settings ===== -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="10">
                <TextBlock x:Name="FileTitle" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock x:Name="NotesText" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />

                <!-- Layers -->
                <TextBlock Text="Layers" FontWeight="Bold" Margin="0,12,0,4" />
                <TextBlock Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Ticked layers come in as parts, in the file's order (the top layer is at the top here). Click a layer, here or on the picture, to pick it." />
                <ListBox x:Name="LayerList" MinHeight="120" MaxHeight="420" SelectionChanged="LayerList_Changed"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" />
                <UniformGrid Columns="2" Margin="0,4,0,0">
                    <Button Content="Tick them all" Margin="0,0,3,0" Click="TickAll_Click" />
                    <Button Content="Only the visible ones" Margin="3,0,0,0" Click="TickVisible_Click"
                            ToolTip="Ticks the layers that show in the file, and unticks the hidden ones" />
                </UniformGrid>

                <!-- Rig -->
                <TextBlock Text="Rig" FontWeight="Bold" Margin="0,14,0,4" />
                <CheckBox x:Name="RigBox" Click="Rig_Click" ToolTip="Without it, the file comes in as a drawn object: just its parts, no bones">
                    <TextBlock Text="Suggest a rig: bones where the layers overlap" TextWrapping="Wrap" />
                </CheckBox>
                <StackPanel x:Name="RigFields" Margin="0,6,0,0">
                    <TextBlock Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="Each layer gets a bone that turns where it overlaps the layer it hangs from. Details lying on another layer (eyes, a belt) ride on that layer's bone instead. Change any of it below; the picture shows the result." />
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="Root" VerticalAlignment="Center" Width="70"
                                   ToolTip="The bone everything else hangs from: usually the body" />
                        <ComboBox x:Name="RootBox" SelectionChanged="Root_Changed" />
                    </DockPanel>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,6">
                        <StackPanel x:Name="LayerFields">
                            <TextBlock x:Name="LayerTitle" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <RadioButton x:Name="OwnBoneChoice" GroupName="Role" Checked="Role_Changed">
                                <TextBlock Text="Its own bone (a part that bends or turns)" TextWrapping="Wrap" />
                            </RadioButton>
                            <RadioButton x:Name="OnBoneChoice" GroupName="Role" Margin="0,4,0,0" Checked="Role_Changed">
                                <TextBlock Text="No bone: it rides on another layer's bone" TextWrapping="Wrap" />
                            </RadioButton>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock x:Name="TargetLabel" Text="Hangs from" VerticalAlignment="Center" Width="70" />
                                <ComboBox x:Name="TargetBox" SelectionChanged="Target_Changed" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Button Content="Suggest the roles again" HorizontalAlignment="Left" Padding="8,1" Click="SuggestRoles_Click"
                            ToolTip="Forgets the changes above and works out each layer's role from the shapes again" />
                </StackPanel>

                <!-- Size -->
                <TextBlock Text="Size" FontWeight="Bold" Margin="0,14,0,4" />
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="ScaleBox" Width="50" LostFocus="Scale_Changed" KeyDown="Scale_KeyDown"
                             ToolTip="Big files can come in smaller: 50 = half the size, in pixels and in placement" />
                    <TextBlock Text="% of the file's size" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>

                <TextBlock x:Name="Summary" TextWrapping="Wrap" Margin="0,14,0,0" />
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Import" IsDefault="True" Width="80" Margin="0,0,6,0" Click="Import_Click" />
                    <Button Content="Cancel" IsCancel="True" Width="75" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
