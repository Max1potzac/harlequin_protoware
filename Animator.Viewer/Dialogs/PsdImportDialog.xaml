<Window x:Class="Animator.Viewer.Dialogs.PsdImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="Import a Photoshop file" Width="1150" Height="800" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" PreviewKeyDown="Window_KeyDown">
    <DockPanel>

        <!-- ===== Settings ===== -->
        <ScrollViewer DockPanel.Dock="Right" Width="370" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <TextBlock x:Name="FileTitle" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock x:Name="NotesText" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0" />

                <!-- Layers -->
                <TextBlock Text="Layers" FontWeight="Bold" Margin="0,12,0,4" />
                <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Ticked layers come in as parts, in the file's order (the top layer is at the top here). Click a layer, here or on the picture, to pick it." />
                <ListBox x:Name="LayerList" Height="250" SelectionChanged="LayerList_Changed" />
                <UniformGrid Columns="2" Margin="0,4,0,0">
                    <Button Content="Tick them all" Margin="0,0,3,0" Click="TickAll_Click" />
                    <Button Content="Only the visible ones" Margin="3,0,0,0" Click="TickVisible_Click"
                            ToolTip="Ticks the layers that show in the file, and unticks the hidden ones" />
                </UniformGrid>

                <!-- Rig -->
                <TextBlock Text="Rig" FontWeight="Bold" Margin="0,14,0,4" />
                <CheckBox x:Name="RigBox" Content="Suggest a rig: bones where the layers overlap" Click="Rig_Click"
                          ToolTip="Without it, the file comes in as a drawn object: just its parts, no bones" />
                <StackPanel x:Name="RigFields" Margin="0,6,0,0">
                    <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="Each layer gets a bone that turns where it overlaps the layer it hangs from. Details lying on another layer (eyes, a belt) ride on that layer's bone instead. Change any of it below; the picture shows the result." />
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="Root" VerticalAlignment="Center" Width="70"
                                   ToolTip="The bone everything else hangs from: usually the body" />
                        <ComboBox x:Name="RootBox" SelectionChanged="Root_Changed" />
                    </DockPanel>
                    <Border BorderBrush="#A0A0A0" BorderThickness="1" Padding="8" Margin="0,0,0,6">
                        <StackPanel x:Name="LayerFields">
                            <TextBlock x:Name="LayerTitle" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <RadioButton x:Name="OwnBoneChoice" GroupName="Role" Content="Its own bone (a part that bends or turns)"
                                         Checked="Role_Changed" />
                            <RadioButton x:Name="OnBoneChoice" GroupName="Role" Margin="0,4,0,0" Checked="Role_Changed"
                                         Content="No bone: it rides on another layer's bone" />
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock x:Name="TargetLabel" Text="Hangs from" VerticalAlignment="Center" Width="70" />
                                <ComboBox x:Name="TargetBox" SelectionChanged="Target_Changed" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Button Content="Suggest the roles again" HorizontalAlignment="Left" Padding="8,1" Click="SuggestRoles_Click"
                            ToolTip="Forgets the changes above and works out each layer's role from the shapes again" />
                </StackPanel>

                <!-- Size -->
                <TextBlock Text="Size" FontWeight="Bold" Margin="0,14,0,4" />
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="ScaleBox" Width="50" LostFocus="Scale_Changed" KeyDown="Scale_KeyDown"
                             ToolTip="Big files can come in smaller: 50 = half the size, in pixels and in placement" />
                    <TextBlock Text="% of the file's size" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>

                <TextBlock x:Name="Summary" TextWrapping="Wrap" Margin="0,14,0,0" />
                <TextBlock x:Name="ErrorText" Foreground="#C03030" TextWrapping="Wrap" Margin="0,4,0,0" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Import" IsDefault="True" Width="80" Margin="0,0,6,0" Click="Import_Click" />
                    <Button Content="Cancel" IsCancel="True" Width="75" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== The picture ===== -->
        <Grid>
            <skia:SKElement x:Name="PreviewView" Focusable="True" PaintSurface="PreviewView_Paint"
                            MouseDown="PreviewView_MouseDown" MouseMove="PreviewView_MouseMove"
                            MouseUp="PreviewView_MouseUp" MouseWheel="PreviewView_MouseWheel" />
            <TextBlock Text="Click: pick a layer   Wheel: zoom   Middle drag: move around   Home: fit" Foreground="#9AA4B2"
                       Margin="8" VerticalAlignment="Bottom" IsHitTestVisible="False" />
        </Grid>
    </DockPanel>
</Window>
