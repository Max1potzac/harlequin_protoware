<Window x:Class="Animator.Viewer.Dialogs.NewPartDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Part" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="Name" Margin="0,0,10,6" VerticalAlignment="Center" />
            <TextBox x:Name="NameBox" Grid.Column="1" Margin="0,0,0,6" />
            <TextBlock Text="Width" Grid.Row="1" Margin="0,0,10,6" VerticalAlignment="Center" />
            <TextBox x:Name="WidthBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" />
            <TextBlock Text="Height" Grid.Row="2" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBox x:Name="HeightBox" Grid.Row="2" Grid.Column="1" />
        </Grid>

        <TextBlock Text="The part starts empty. Paint it in the part editor, and resize its canvas any time."
                   Foreground="Gray" TextWrapping="Wrap" MaxWidth="230" Margin="0,10,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" IsDefault="True" Width="75" Margin="0,0,6,0" Click="Ok_Click" />
            <Button Content="Cancel" IsCancel="True" Width="75" />
        </StackPanel>
    </StackPanel>
</Window>