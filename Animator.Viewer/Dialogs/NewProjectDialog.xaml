<Window x:Class="Animator.Viewer.Dialogs.NewProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Project" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="14" Width="360">

        <RadioButton x:Name="CharacterChoice" GroupName="Kind" Content="Character" FontWeight="Bold"
                     IsChecked="True" Checked="Kind_Changed" />
        <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="20,2,0,4"
                   Text="One character (or prop) and its animations, for games. You start inside it, ready to rig and animate." />
        <CheckBox x:Name="DemoBox" Content="Start from the demo character" IsChecked="True" Margin="20,0,0,12"
                  ToolTip="Off: an empty rig with one bone to build on" />

        <RadioButton x:Name="AnimationChoice" GroupName="Kind" Content="Animation" FontWeight="Bold"
                     Checked="Kind_Changed" />
        <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="20,2,0,6"
                   Text="A whole scene played over time on the scene timeline, for a video or GIF. It starts with a blank background the size of the stage." />
        <Grid x:Name="AnimationFields" Margin="20,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="60" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="Stage" VerticalAlignment="Center" Margin="0,0,10,6"
                       ToolTip="The picture the scene is made for, in pixels (its video size)" />
            <TextBox x:Name="StageWidthBox" Grid.Column="1" Margin="0,0,0,6" />
            <TextBlock Text="×" Grid.Column="2" VerticalAlignment="Center" Margin="6,0,6,6" />
            <TextBox x:Name="StageHeightBox" Grid.Column="3" Margin="0,0,0,6" />
            <TextBlock Text="Length (frames)" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox x:Name="LengthBox" Grid.Row="1" Grid.Column="1" />
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <TextBlock Text="Frames per second" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox x:Name="FpsBox" Width="50" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Create" IsDefault="True" Width="75" Margin="0,0,6,0" Click="Create_Click" />
            <Button Content="Cancel" IsCancel="True" Width="75" />
        </StackPanel>
    </StackPanel>
</Window>
