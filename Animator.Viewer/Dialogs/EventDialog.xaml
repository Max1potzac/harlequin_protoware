<Window x:Class="Animator.Viewer.Dialogs.EventDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Event" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="14">
        <TextBlock x:Name="Heading" Margin="0,0,0,10" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="Name" Margin="0,0,10,6" VerticalAlignment="Center" />
            <TextBox x:Name="NameBox" Grid.Column="1" Margin="0,0,0,6" />
            <TextBlock Text="Data (optional)" Grid.Row="1" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBox x:Name="DataBox" Grid.Row="1" Grid.Column="1" />
        </Grid>

        <TextBlock Foreground="Gray" TextWrapping="Wrap" MaxWidth="300" Margin="0,10,0,0"
                   Text="The game reacts to the name, for example footstep, shoot or arm_off. Data can carry extra information, such as which bone or which sound." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" IsDefault="True" Width="75" Margin="0,0,6,0" Click="Ok_Click" />
            <Button Content="Cancel" IsCancel="True" Width="75" />
        </StackPanel>
    </StackPanel>
</Window>
