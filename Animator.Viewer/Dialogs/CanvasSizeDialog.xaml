<Window x:Class="Animator.Viewer.Dialogs.CanvasSizeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Canvas Size" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <StackPanel Margin="14">
        <TextBlock x:Name="CurrentSize" Margin="0,0,0,10" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="Width" Margin="0,0,10,6" VerticalAlignment="Center" />
            <TextBox x:Name="WidthBox" Grid.Column="1" Margin="0,0,0,6" />
            <TextBlock Text="Height" Grid.Row="1" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBox x:Name="HeightBox" Grid.Row="1" Grid.Column="1" />
        </Grid>

        <TextBlock Text="Anchor (where the existing image stays):" Margin="0,12,0,4" />
        <UniformGrid x:Name="AnchorGrid" Rows="3" Columns="3" Width="90" Height="90" HorizontalAlignment="Left" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" IsDefault="True" Width="75" Margin="0,0,6,0" Click="Ok_Click" />
            <Button Content="Cancel" IsCancel="True" Width="75" />
        </StackPanel>
    </StackPanel>
</Window>