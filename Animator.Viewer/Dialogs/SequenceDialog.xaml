<Window x:Class="Animator.Viewer.Dialogs.SequenceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Animation sequence" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="14" MaxWidth="360">
        <TextBlock x:Name="Heading" TextWrapping="Wrap" Margin="0,0,0,10" />

        <DockPanel>
            <TextBlock Text="Name" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBox x:Name="NameBox" />
        </DockPanel>
        <TextBlock x:Name="ErrorText" Foreground="#C03030" TextWrapping="Wrap" Margin="0,4,0,0" />

        <TextBlock x:Name="Explanation" Foreground="Gray" TextWrapping="Wrap" Margin="0,6,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton" IsDefault="True" Width="75" Margin="0,0,6,0" Click="Ok_Click" />
            <Button Content="Cancel" IsCancel="True" Width="75" />
        </StackPanel>
    </StackPanel>
</Window>
