<Window x:Class="Animator.Viewer.Dialogs.ExportProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exporting…" SizeToContent="Height" Width="380" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Closing="Window_Closing">
    <StackPanel Margin="14">
        <TextBlock x:Name="StepText" Text="Getting ready" Margin="0,0,0,8" />
        <ProgressBar x:Name="Bar" Height="16" Minimum="0" Maximum="1" />
        <Button x:Name="CancelButton" Content="Cancel" Width="80" HorizontalAlignment="Right" Margin="0,12,0,0"
                Click="Cancel_Click" ToolTip="Stops, and removes the files written so far" />
    </StackPanel>
</Window>
