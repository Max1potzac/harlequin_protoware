<Window x:Class="Animator.Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="Animator" Height="860" Width="1450"
        Closing="Window_Closing"
        PreviewKeyDown="Window_KeyDown">
        <DockPanel>
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="_File">
                    <MenuItem Header="_New" InputGestureText="Ctrl+N" Click="New_Click" />
                    <MenuItem Header="_Open…" InputGestureText="Ctrl+O" Click="Open_Click" />
                    <Separator />
                    <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="Save_Click" />
                    <MenuItem Header="Save _As…" InputGestureText="Ctrl+Shift+S" Click="SaveAs_Click" />
                    <Separator />
                    <MenuItem Header="E_xit" Click="Exit_Click" />
                </MenuItem>
            </Menu>
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="214" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="PaintColumn" Width="0" />
        </Grid.ColumnDefinitions>

            <DockPanel Grid.Row="0" Grid.Column="0">

                <!-- ===== Rig panel ===== -->
                <DockPanel DockPanel.Dock="Left" Width="250" Background="#24272E">
                    <TextBlock DockPanel.Dock="Top" Text="Rig" Foreground="White" FontWeight="Bold" Margin="8,6,8,4" />

                    <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="6,0,6,6">
                        <Button Content="+ Bone" Margin="0,0,3,0" Click="AddBone_Click"
                    ToolTip="Adds a child of the selected bone (or a root bone). Tip: Ctrl+drag in the viewport draws one." />
                        <Button Content="+ Part ▾" Margin="3,0,3,0" Click="AddPart_Click"
                    ToolTip="Adds a part (blank, or from an image) to the selected bone" />
                        <Button x:Name="DeleteButton" Content="Delete" Margin="3,0,0,0" Click="Delete_Click"
                    ToolTip="Deletes the selected part, or the selected bone with everything on it (undoable)" />
                    </UniformGrid>

                    <!-- Properties of the selected bone -->
                    <ScrollViewer DockPanel.Dock="Bottom" VerticalScrollBarVisibility="Auto" MaxHeight="430">
                        <Grid x:Name="BoneProps" Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="PropsTitle" Grid.Row="0" Grid.ColumnSpan="3" Foreground="#9AA4B2" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="1" Text="Name" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                            <TextBox x:Name="BoneName" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,4"
                 Tag="Name" KeyDown="BoneField_KeyDown" LostFocus="BoneField_LostFocus" />

                            <TextBlock Grid.Row="2" Text="Parent" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                            <ComboBox x:Name="BoneParent" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,4"
                  SelectionChanged="BoneParent_Changed" />

                            <TextBlock Grid.Row="3" Text="X / Y" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                            <TextBox x:Name="BoneX" Grid.Row="3" Grid.Column="1" Margin="0,0,2,4"
                 Tag="X" KeyDown="BoneField_KeyDown" LostFocus="BoneField_LostFocus" />
                            <TextBox x:Name="BoneY" Grid.Row="3" Grid.Column="2" Margin="2,0,0,4"
                 Tag="Y" KeyDown="BoneField_KeyDown" LostFocus="BoneField_LostFocus" />

                            <TextBlock Grid.Row="4" Text="Rot° / Len" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                            <TextBox x:Name="BoneRotation" Grid.Row="4" Grid.Column="1" Margin="0,0,2,4"
                 Tag="Rotation" KeyDown="BoneField_KeyDown" LostFocus="BoneField_LostFocus" />
                            <TextBox x:Name="BoneLength" Grid.Row="4" Grid.Column="2" Margin="2,0,0,4"
                 Tag="Length" KeyDown="BoneField_KeyDown" LostFocus="BoneField_LostFocus" />

                            <TextBlock Grid.Row="5" Text="Scale" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                            <TextBox x:Name="BoneScaleX" Grid.Row="5" Grid.Column="1" Margin="0,0,2,4"
                 Tag="ScaleX" KeyDown="BoneField_KeyDown" LostFocus="BoneField_LostFocus" />
                            <TextBox x:Name="BoneScaleY" Grid.Row="5" Grid.Column="2" Margin="2,0,0,4"
                 Tag="ScaleY" KeyDown="BoneField_KeyDown" LostFocus="BoneField_LostFocus" />

                            <TextBlock Grid.Row="6" Text="Turn° / Tilt°" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                            <TextBox x:Name="BoneTurn" Grid.Row="6" Grid.Column="1" Margin="0,0,2,4"
                 Tag="Turn" KeyDown="BoneField_KeyDown" LostFocus="BoneField_LostFocus"
                 ToolTip="Depth rotation around the bone's length: parts narrow, and mirror across the bone at 180°" />
                            <TextBox x:Name="BoneTilt" Grid.Row="6" Grid.Column="2" Margin="2,0,0,4"
                 Tag="Tilt" KeyDown="BoneField_KeyDown" LostFocus="BoneField_LostFocus"
                 ToolTip="Depth rotation across the bone: it foreshortens, and mirrors along itself at 180°" />

                            <StackPanel Grid.Row="7" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,2,0,6">
                                <CheckBox x:Name="BoneInheritRotation" Content="Inherit rotation" Foreground="White"
                      Margin="0,0,10,0" Click="BoneInherit_Click" />
                                <CheckBox x:Name="BoneInheritScale" Content="Inherit scale" Foreground="White"
                      Click="BoneInherit_Click" />
                            </StackPanel>

                            <TextBlock Grid.Row="8" Text="Look at" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                            <ComboBox x:Name="LookTarget" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,4"
                  SelectionChanged="LookTarget_Changed"
                  ToolTip="Makes this bone (e.g. an iris) move toward the chosen bone, inside a boundary" />

                            <TextBlock Grid.Row="9" Text="Shape / Follow" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                            <ComboBox x:Name="LookShapeBox" Grid.Row="9" Grid.Column="1" Margin="0,0,2,4"
                  SelectionChanged="LookShape_Changed" />
                            <TextBox x:Name="LookFollow" Grid.Row="9" Grid.Column="2" Margin="2,0,0,4"
                 Tag="Follow" KeyDown="BoneField_KeyDown" LostFocus="BoneField_LostFocus"
                 ToolTip="How strongly it follows: 0.1 = subtle, 1 = goes straight to the edge" />

                            <TextBlock Grid.Row="10" Text="Range X / Y" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,6" />
                            <TextBox x:Name="LookRangeX" Grid.Row="10" Grid.Column="1" Margin="0,0,2,6"
                 Tag="RangeX" KeyDown="BoneField_KeyDown" LostFocus="BoneField_LostFocus" />
                            <TextBox x:Name="LookRangeY" Grid.Row="10" Grid.Column="2" Margin="2,0,0,6"
                 Tag="RangeY" KeyDown="BoneField_KeyDown" LostFocus="BoneField_LostFocus" />

                            <TextBlock Grid.Row="11" Text="IK chain" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                            <ComboBox x:Name="IkLength" Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,4"
                  SelectionChanged="IkLength_Changed"
                  ToolTip="Make this bone the END of an IK chain (hand, foot, tail tip). 2 bones = arm or leg, 1 = aim." />

                            <TextBlock Grid.Row="12" Text="IK target" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                            <ComboBox x:Name="IkTargetBox" Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,4"
                  SelectionChanged="IkTarget_Changed" />

                            <StackPanel Grid.Row="13" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,2,0,4">
                                <CheckBox x:Name="IkOn" Content="IK on" Foreground="White" Margin="0,0,10,0" Click="IkOptions_Click"
                      ToolTip="Off = the chain plays its FK keys (same as the I key)" />
                                <CheckBox x:Name="IkFlip" Content="Flip bend" Foreground="White" Click="IkOptions_Click"
                      ToolTip="Which way the middle joint (elbow, knee) bends (same as the B key)" />
                            </StackPanel>

                            <TextBlock x:Name="RigHint" Grid.Row="14" Grid.ColumnSpan="3" Foreground="#FF8080" TextWrapping="Wrap" />
                        </Grid>
                    </ScrollViewer>
                    <Grid x:Name="PartProps" DockPanel.Dock="Bottom" Margin="6" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="PartTitle" Grid.Row="0" Grid.ColumnSpan="3" Foreground="#9AA4B2"
               TextWrapping="Wrap" Margin="0,0,0,6" />

                        <TextBlock Grid.Row="1" Text="Name" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                        <TextBox x:Name="PartName" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,4"
             Tag="PName" KeyDown="PartField_KeyDown" LostFocus="PartField_LostFocus" />

                        <TextBlock Grid.Row="2" Text="Bone" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                        <ComboBox x:Name="PartBone" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,4"
              SelectionChanged="PartBone_Changed"
              ToolTip="Moves the part to another bone; it stays where it is on screen" />

                        <TextBlock Grid.Row="3" Text="X / Y" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                        <TextBox x:Name="PartX" Grid.Row="3" Grid.Column="1" Margin="0,0,2,4"
             Tag="PX" KeyDown="PartField_KeyDown" LostFocus="PartField_LostFocus" />
                        <TextBox x:Name="PartY" Grid.Row="3" Grid.Column="2" Margin="2,0,0,4"
             Tag="PY" KeyDown="PartField_KeyDown" LostFocus="PartField_LostFocus" />

                        <TextBlock Grid.Row="4" Text="Rotation°" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                        <TextBox x:Name="PartRotation" Grid.Row="4" Grid.Column="1" Margin="0,0,2,4"
             Tag="PRotation" KeyDown="PartField_KeyDown" LostFocus="PartField_LostFocus" />

                        <TextBlock Grid.Row="5" Text="Scale" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                        <TextBox x:Name="PartScaleX" Grid.Row="5" Grid.Column="1" Margin="0,0,2,4"
             Tag="PScaleX" KeyDown="PartField_KeyDown" LostFocus="PartField_LostFocus" />
                        <TextBox x:Name="PartScaleY" Grid.Row="5" Grid.Column="2" Margin="2,0,0,4"
             Tag="PScaleY" KeyDown="PartField_KeyDown" LostFocus="PartField_LostFocus" />

                        <TextBlock Grid.Row="6" Text="Pivot (px)" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,4" />
                        <TextBox x:Name="PartPivotX" Grid.Row="6" Grid.Column="1" Margin="0,0,2,4"
             Tag="PPivotX" KeyDown="PartField_KeyDown" LostFocus="PartField_LostFocus"
             ToolTip="Pixel of the image that rotation and scaling turn around (the image doesn't move)" />
                        <TextBox x:Name="PartPivotY" Grid.Row="6" Grid.Column="2" Margin="2,0,0,4"
             Tag="PPivotY" KeyDown="PartField_KeyDown" LostFocus="PartField_LostFocus" />

                        <UniformGrid Grid.Row="7" Grid.ColumnSpan="3" Columns="3" Margin="0,4,0,4">
                            <Button x:Name="EditPixelsButton" Content="Edit pixels" Margin="0,0,3,0" Click="EditPixels_Click" />
                            <Button x:Name="PartFront" Content="▲ Front" Margin="3,0,3,0" Click="PartFront_Click"
                ToolTip="Draw this part later (in front of more parts)" />
                            <Button x:Name="PartBack" Content="▼ Back" Margin="3,0,0,0" Click="PartBack_Click"
                ToolTip="Draw this part earlier (behind more parts)" />
                        </UniformGrid>

                        <TextBlock x:Name="PartHint" Grid.Row="8" Grid.ColumnSpan="3" Foreground="#FF8080" TextWrapping="Wrap" />
                    </Grid>

                    <!-- Bone hierarchy (fills the remaining space) -->
                    <TreeView x:Name="BoneTree" Background="#1E2026" BorderThickness="0" Margin="6,0,6,0"
                  SelectedItemChanged="BoneTree_SelectedItemChanged" />
                </DockPanel>

                <!-- ===== Viewport ===== -->
                <Grid>
                    <skia:SKElement x:Name="Viewport" Focusable="True" FocusVisualStyle="{x:Null}" PaintSurface="OnPaintSurface"
                        MouseDown="Viewport_MouseDown" MouseMove="Viewport_MouseMove"
                        MouseUp="Viewport_MouseUp" MouseWheel="Viewport_MouseWheel" />
                    <TextBlock x:Name="Status" Foreground="White" Margin="10"
                   VerticalAlignment="Bottom" IsHitTestVisible="False" TextWrapping="Wrap" />
                </Grid>
            </DockPanel>

            <GridSplitter x:Name="PaintSplitter" Grid.Row="0" Grid.Column="1" Width="5"
                      HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                      Background="#1B1D22" Visibility="Collapsed" />

        <DockPanel x:Name="PaintPanel" Grid.Row="0" Grid.Column="2" Background="#24272E" Visibility="Collapsed">

            <DockPanel DockPanel.Dock="Top" Margin="6">
                <Button Content="Close (Esc)" DockPanel.Dock="Right" Padding="8,2" Click="ClosePaint_Click" />
                <Button Content="Canvas size…" DockPanel.Dock="Right" Padding="8,2" Margin="0,0,6,0" Click="CanvasSize_Click" />
                <TextBlock x:Name="PaintTitle" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" />
            </DockPanel>

            <WrapPanel x:Name="ToolButtons" DockPanel.Dock="Top" Margin="6,0,6,6">
                <RadioButton Content="Select (M)" Tag="Select" GroupName="PaintTools" Click="Tool_Click"
                             Style="{StaticResource {x:Type ToggleButton}}" Padding="6,2" Margin="0,0,4,4" />
                <RadioButton Content="Move (V)" Tag="Move" GroupName="PaintTools" Click="Tool_Click"
                             Style="{StaticResource {x:Type ToggleButton}}" Padding="6,2" Margin="0,0,4,4" />
                <RadioButton Content="Pencil (N)" Tag="Pencil" GroupName="PaintTools" Click="Tool_Click"
                             Style="{StaticResource {x:Type ToggleButton}}" Padding="6,2" Margin="0,0,4,4" />
                <RadioButton Content="Brush (B)" Tag="Brush" GroupName="PaintTools" Click="Tool_Click"
                             Style="{StaticResource {x:Type ToggleButton}}" Padding="6,2" Margin="0,0,4,4" />
                <RadioButton Content="Mixer (X)" Tag="Mixer" GroupName="PaintTools" Click="Tool_Click"
                             Style="{StaticResource {x:Type ToggleButton}}" Padding="6,2" Margin="0,0,4,4" />
                <RadioButton Content="Eraser (E)" Tag="Eraser" GroupName="PaintTools" Click="Tool_Click"
                             Style="{StaticResource {x:Type ToggleButton}}" Padding="6,2" Margin="0,0,4,4" />
                <RadioButton Content="Picker (I)" Tag="Picker" GroupName="PaintTools" Click="Tool_Click"
                             Style="{StaticResource {x:Type ToggleButton}}" Padding="6,2" Margin="0,0,4,4" />
                <RadioButton Content="Fill (G)" Tag="Fill" GroupName="PaintTools" Click="Tool_Click"
                             Style="{StaticResource {x:Type ToggleButton}}" Padding="6,2" Margin="0,0,4,4" />
                <RadioButton Content="Gradient (D)" Tag="Gradient" GroupName="PaintTools" Click="Tool_Click"
                             Style="{StaticResource {x:Type ToggleButton}}" Padding="6,2" Margin="0,0,4,4" />
                <RadioButton Content="Figure (U)" Tag="Figure" GroupName="PaintTools" Click="Tool_Click"
                             Style="{StaticResource {x:Type ToggleButton}}" Padding="6,2" Margin="0,0,4,4" />
            </WrapPanel>

            <WrapPanel DockPanel.Dock="Top" Margin="6,0,6,6">
                <Grid Width="38" Height="34" Margin="0,0,4,0"
          ToolTip="Primary (front) and secondary (back). Right-click a palette color to set the secondary.">
                    <Border x:Name="SecondarySwatch" Width="22" Height="22" HorizontalAlignment="Right"
                VerticalAlignment="Bottom" BorderBrush="White" BorderThickness="1" />
                    <Border x:Name="ColorSwatch" Width="22" Height="22" HorizontalAlignment="Left"
                VerticalAlignment="Top" BorderBrush="White" BorderThickness="1" />
                </Grid>
                <Button Content="⇄" ToolTip="Swap colors (S)" Padding="5,0" Margin="0,0,6,0" Click="SwapColors_Click" />
                <TextBox x:Name="ColorHex" Width="86" VerticalContentAlignment="Center"
             LostFocus="ColorHex_Commit" KeyDown="ColorHex_KeyDown" ToolTip="#RRGGBB or #AARRGGBB" />
                <TextBlock Text="Size" Foreground="White" VerticalAlignment="Center" Margin="12,0,4,0" />
                <Slider x:Name="SizeSlider" Width="110" Minimum="1" Maximum="64" Value="4"
            IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
            ValueChanged="SizeSlider_Changed" />
                <TextBlock x:Name="SizeLabel" Foreground="White" Width="24" Margin="4,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="Fill tolerance" Foreground="White" VerticalAlignment="Center" Margin="12,0,4,0" />
                <Slider x:Name="ToleranceSlider" Width="90" Minimum="0" Maximum="128" Value="24"
            IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
            ValueChanged="ToleranceSlider_Changed" />
                <CheckBox x:Name="SampleAllBox" Content="Sample all layers" Foreground="White"
              VerticalAlignment="Center" Margin="12,0,0,0" Click="SampleAll_Click"
              ToolTip="Fill and Mixer read the merged image instead of only this layer" />
                <CheckBox x:Name="GradientTransparentBox" Content="Gradient to transparent" Foreground="White"
              VerticalAlignment="Center" Margin="12,0,0,0" Click="GradientTransparent_Click"
              ToolTip="Off: primary → secondary. On: primary → transparent." />
            </WrapPanel>

            <WrapPanel DockPanel.Dock="Top" Margin="6,0,6,6">
                <TextBlock Text="Mixer:  Wet" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0" />
                <Slider x:Name="WetSlider" Width="100" Minimum="0" Maximum="100" Value="50"
                        VerticalAlignment="Center" ValueChanged="MixSliders_Changed"
                        ToolTip="How much paint the brush picks up from the canvas" />
                <TextBlock Text="Load" Foreground="White" VerticalAlignment="Center" Margin="12,0,4,0" />
                <Slider x:Name="LoadSlider" Width="100" Minimum="0" Maximum="100" Value="20"
                        VerticalAlignment="Center" ValueChanged="MixSliders_Changed"
                        ToolTip="How quickly the brush refills with your color (0 = smudge)" />
            </WrapPanel>

            <WrapPanel DockPanel.Dock="Top" Margin="6,0,6,6">
                <TextBlock Text="Figure:" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox x:Name="FigureShapeBox" Width="100" SelectionChanged="FigureShape_Changed" />
                <ComboBox x:Name="FigureStyleBox" Width="120" Margin="8,0,0,0" SelectionChanged="FigureStyle_Changed" />
                <CheckBox x:Name="FigureSmoothBox" Content="Smooth edges" Foreground="White" IsChecked="True"
                          VerticalAlignment="Center" Margin="12,0,0,0" Click="FigureOption_Click" />
                <TextBlock Text="Polygon sides" Foreground="White" VerticalAlignment="Center" Margin="12,0,4,0" />
                <Slider x:Name="SidesSlider" Width="80" Minimum="3" Maximum="12" Value="5"
                        IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                        ValueChanged="SidesSlider_Changed" />
                <TextBlock x:Name="SidesLabel" Foreground="White" Width="20" Margin="4,0,0,0" VerticalAlignment="Center" />
            </WrapPanel>

            <WrapPanel x:Name="Palette" DockPanel.Dock="Top" Margin="6,0,6,6" />

            <DockPanel DockPanel.Dock="Right" Width="190" Margin="0,0,6,6">
                <TextBlock DockPanel.Dock="Top" Text="Layers (top first)" Foreground="White" Margin="0,0,0,4" />
                <UniformGrid DockPanel.Dock="Bottom" Columns="4" Margin="0,4,0,0">
                    <Button Content="+" ToolTip="Add layer" Click="LayerAdd_Click" />
                    <Button Content="−" ToolTip="Delete layer" Click="LayerDelete_Click" />
                    <Button Content="▲" ToolTip="Move layer up" Click="LayerUp_Click" />
                    <Button Content="▼" ToolTip="Move layer down" Click="LayerDown_Click" />
                </UniformGrid>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                    <TextBox x:Name="LayerName" ToolTip="Layer name (Enter to apply)"
                             KeyDown="LayerName_KeyDown" LostFocus="LayerName_Commit" />
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="Opacity" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Slider x:Name="LayerOpacity" Minimum="0" Maximum="100" Value="100"
                                VerticalAlignment="Center" ValueChanged="LayerOpacity_Changed" />
                    </DockPanel>
                </StackPanel>
                <ListBox x:Name="LayerList" Background="#1E2026" Foreground="White"
                         SelectionChanged="LayerList_SelectionChanged" />
            </DockPanel>

            <skia:SKElement x:Name="PaintView" Cursor="Cross"
                            Focusable="True" FocusVisualStyle="{x:Null}" PaintSurface="OnPaintViewPaint"
                            MouseDown="PaintView_MouseDown" MouseMove="PaintView_MouseMove"
                            MouseUp="PaintView_MouseUp" MouseWheel="PaintView_MouseWheel"
                            MouseLeave="PaintView_MouseLeave" />
        </DockPanel>

            <DockPanel Grid.Row="1" Grid.ColumnSpan="3">
                <WrapPanel DockPanel.Dock="Top" Background="#24272E">
                    <TextBlock Text="Animation" Foreground="White" VerticalAlignment="Center" Margin="8,4,6,4" />
                    <ComboBox x:Name="AnimList" Width="160" Margin="0,4,6,4" DisplayMemberPath="Name"
                  SelectionChanged="AnimList_Changed" />
                    <Button Content="+ New" Padding="6,1" Margin="0,4,4,4" Click="AnimNew_Click" />
                    <Button Content="Duplicate" Padding="6,1" Margin="0,4,4,4" Click="AnimDuplicate_Click" />
                    <Button x:Name="AnimDeleteButton" Content="Delete" Padding="6,1" Margin="0,4,14,4" Click="AnimDelete_Click" />

                    <TextBlock Text="Name" Foreground="White" VerticalAlignment="Center" Margin="0,4,4,4" />
                    <TextBox x:Name="AnimName" Width="130" Margin="0,4,12,4" VerticalContentAlignment="Center"
                 Tag="Name" KeyDown="AnimField_KeyDown" LostFocus="AnimField_LostFocus" />
                    <TextBlock Text="Length (frames)" Foreground="White" VerticalAlignment="Center" Margin="0,4,4,4" />
                    <TextBox x:Name="AnimLength" Width="50" Margin="0,4,12,4" VerticalContentAlignment="Center"
                 Tag="Length" KeyDown="AnimField_KeyDown" LostFocus="AnimField_LostFocus" />
                    <TextBlock Text="FPS" Foreground="White" VerticalAlignment="Center" Margin="0,4,4,4" />
                    <TextBox x:Name="AnimFps" Width="40" Margin="0,4,12,4" VerticalContentAlignment="Center"
                 Tag="Fps" KeyDown="AnimField_KeyDown" LostFocus="AnimField_LostFocus"
                 ToolTip="Frames per second for the whole project. Timing is kept in seconds." />
                    <CheckBox x:Name="AnimLoop" Content="Loop" Foreground="White" VerticalAlignment="Center"
                  Margin="0,4,12,4" Click="AnimLoop_Click" />
                    <TextBlock x:Name="AnimHint" Foreground="#FF8080" VerticalAlignment="Center" Margin="0,4,8,4" />
                </WrapPanel>

                <skia:SKElement x:Name="TimelineView" Focusable="True" FocusVisualStyle="{x:Null}" PaintSurface="OnTimelinePaint"
                    MouseDown="Timeline_MouseDown" MouseMove="Timeline_MouseMove"
                    MouseUp="Timeline_MouseUp" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>