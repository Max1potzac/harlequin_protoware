<Project Sdk="Microsoft.NET.Sdk">

  <!-- Harlequin's editor on Avalonia: the same editor for Linux, Windows and macOS, on the engine
       (Animator.Engine). docs/porting.md tells how it came to replace the WPF one. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>harlequin-editor</AssemblyName>
    <RootNamespace>Animator.Desktop</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\harlequin.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Published for a platform (dotnet publish -r win-x64, linux-x64…): one program file, with
       .NET and the libraries inside it (the native ones unpacked to a cache on the first run).
       Only what's loaded its own way stays beside it: ANGLE (Avalonia's drawing on Windows) and
       OpenAL Soft (sound). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <Target Name="KeepSomeLibrariesBeside" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Condition="'%(ResolvedFileToPublish.Filename)' == 'av_libglesv2' Or '%(ResolvedFileToPublish.Filename)' == 'soft_oal' Or '%(ResolvedFileToPublish.Filename)' == 'libopenal'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <!-- The engine draws with SkiaSharp 4: Avalonia 12.1 takes it when it's asked for by name
         (its own default is 3), the managed library and the native ones alike -->
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="4.153.1" />
    <!-- Sound: OpenAL Soft (its library for Windows, Linux and macOS comes with the package), and
         managed readers for MP3 and Ogg Vorbis (WAV is read here) -->
    <PackageReference Include="Silk.NET.OpenAL" Version="2.22.0" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    <PackageReference Include="NLayer" Version="1.16.0" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Animator.Engine\Animator.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Animator.Desktop.Tests" />
  </ItemGroup>

  <!-- The window's icon (the program file's is ApplicationIcon) -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\harlequin.ico" />
  </ItemGroup>

</Project>
